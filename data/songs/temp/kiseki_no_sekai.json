  "calls": [],
  "lyrics": [
    {
      "ja": "見上げた空に 描いた夢",
      "romaji": "Miageta sora ni egaita yume",
      "en": "The dream I drew in the sky I looked up at",
      "zh": "仰望天空所描繪的夢想",
      "notes": [
        {
          "word": "見上げた",
          "meaning": "looked up"
        }
      ]
    },
    {
      "ja": "いつか叶うと 信じてた",
      "romaji": "Itsuka kanau to shinjiteta",
      "en": "I believed it would come true someday",
      "zh": "曾深信總有一天會實現",
      "notes": [
        {
          "word": "叶う",
          "meaning": "come true"
        }
      ]
    },
    {
      "ja": "小さな手で 掴んだ光",
      "romaji": "Chiisana te de tsukanda hikari",
      "en": "The light I grasped with my small hands",
      "zh": "以小小的雙手所抓住的光芒",
      "notes": [
        {
          "word": "掴んだ",
          "meaning": "grasped"
        }
      ]
    },
    {
      "ja": "未来へ続く 道しるべ",
      "romaji": "Mirai e tsuzuku michishirube",
      "en": "A guidepost leading to the future",
      "zh": "是通往未來的指引"
    },
    {
      "ja": "不安な夜も 乗り越えてきた",
      "romaji": "Fuan na yoru mo norikoete kita",
      "en": "I've overcome anxious nights",
      "zh": "也曾跨越不安的夜晚",
      "notes": [
        {
          "word": "乗り越えてきた",
          "meaning": "overcome"
        }
      ]
    },
    {
      "ja": "君と歩んだ 軌跡の先",
      "romaji": "Kimi to ayunda kiseki no saki",
      "en": "Beyond the path I walked with you",
      "zh": "在與你一同走過的軌跡前方",
      "notes": [
        {
          "word": "軌跡",
          "meaning": "path/trajectory"
        }
      ]
    },
    {
      "ja": "キセキノセカイ 広がるステージ",
      "romaji": "Kiseki no sekai hirogaru suteeji",
      "en": "A world of miracles, an expanding stage",
      "zh": "奇蹟的世界，廣闊的舞台",
      "notes": [
        {
          "word": "キセキノセカイ",
          "meaning": "world of miracles"
        }
      ]
    },
    {
      "ja": "歌声響かせ 届けたい",
      "romaji": "Utagoe hibikase todoketai",
      "en": "I want to make my singing voice echo and reach you",
      "zh": "想讓歌聲迴盪，傳達給你",
      "notes": null
    }
  ]
