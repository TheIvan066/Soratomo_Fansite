  "calls": [],
  "lyrics": [
    {
      "ja": "星の降る庭で 君と出会った",
      "romaji": "Hoshi no furu niwa de kimi to deatta",
      "en": "In a garden where stars fall, I met you.",
      "zh": "在星光灑落的庭院，與你相遇"
    },
    {
      "ja": "あの日からずっと 夢を見てる",
      "romaji": "Ano hi kara zutto yume wo miteru",
      "en": "Ever since that day, I've been dreaming.",
      "zh": "從那天起，我一直做著夢"
    },
    {
      "ja": "小さな手を繋ぎ 歩いた道",
      "romaji": "Chiisana te wo tsunagi aruita michi",
      "en": "The path we walked, holding our small hands,",
      "zh": "牽著小手，我們走過的路"
    },
    {
      "ja": "忘れないよ この想い",
      "romaji": "Wasurenai yo kono omoi",
      "en": "I won't forget these feelings.",
      "zh": "這份心意，我不會忘記"
    },
    {
      "ja": "時が流れても 色褪せない",
      "romaji": "Toki ga nagarete mo iroasenai",
      "en": "Even as time flows, it won't fade,",
      "zh": "即使時光流逝，也不會褪色"
    },
    {
      "ja": "輝く記憶 胸に抱いて",
      "romaji": "Kagayaku kioku mune ni daite",
      "en": "Holding these shining memories in my heart.",
      "zh": "將閃耀的記憶，擁入懷中"
    },
    {
      "ja": "未来へ続く 道を照らす",
      "romaji": ""
    }
  ]
}
