  "lyrics": [
    {
      "ja": "ねぇ どんな時も 隣にいてくれたね",
      "romaji": "Nee donna toki mo tonari ni ite kureta ne",
      "en": "Hey, you were always by my side, weren't you?",
      "zh": "嘿，無論何時你都陪伴在我身旁，"
    },
    {
      "ja": "ありがとう",
      "romaji": "Arigatou",
      "en": "Thank you.",
      "zh": "謝謝你。"
    },
    {
      "ja": "不安な夜も 涙の朝も",
      "romaji": "Fuan na yoru mo namida no asa mo",
      "en": "Through anxious nights and tearful mornings,",
      "zh": "無論是不安的夜晚，還是淚流的清晨，"
    },
    {
      "ja": "乗り越えてきた",
      "romaji": "Norikoete kita",
      "en": "We've overcome them all.",
      "zh": "我們都一同跨越了。"
    },
    {
      "ja": "ラッキーセブンスホイッスル",
      "romaji": "Rakkī Sebunsu Hoissuru",
      "en": "The Lucky Seventh Whistle",
      "zh": "幸運七號哨聲，"
    },
    {
      "ja": "鳴り響く空へ 夢を追いかけて",
      "romaji": "Narihibiku sora e yume o oikakete",
      "en": "Echoes to the sky, chasing after dreams.",
      "zh": "響徹天際，追逐著夢想。"
    },
    {
      "ja": "ねぇ どんな日も 笑顔をくれたね",
      "romaji": "Nee donna hi mo egao o kureta ne",
      "en": "Hey, you always gave me a smile, didn't you?",
      "zh": "嘿，無論哪一天你都給了我笑容，"
    },
    {
      "ja": "ありがとう",
      "romaji": "Arigatou",
      "en": "Thank you.",
      "zh": "謝謝你。"
    },
    {
      "ja": "迷う日も 立ち止まる日も",
      "romaji": "Mayou hi mo tachidomaru hi mo",
      "en": "Even on days I hesitated or stopped,",
      "zh": "無論是迷惘的日子，還是停滯不前的時候，"
    },
    {
      "ja": "進んでこれた",
      "romaji": "Susunde koreta",
      "en": "I was able to move forward.",
      "zh": "我們都得以繼續前進。"
    },
    {
      "ja": "ラッキーセブンスホイッスル",
      "romaji": "Rakkī Sebunsu Hoissuru",
      "en": "The Lucky Seventh Whistle",
      "zh": "幸運七號哨聲，"
    },
    {
      "ja": "鳴り響く空へ 夢を追いかけて",
      "romaji": "Narihibiku sora e yume o oikakete",
      "en": "Echoes to the sky, chasing after dreams.",
      "zh": "響徹天際，追逐著夢想。"
    },
    {
      "ja": "七色の虹 架かる未来へ",
      "romaji": "Nanairo no niji kakaru mirai e",
      "en": "Towards a future where a seven-colored rainbow bridges.",
      "zh": "朝向七彩虹橋高掛的未來。"
    },
    {
      "ja": "ラッキーセブンスホイッスル",
      "romaji": "Rakkī Sebunsu Hoissuru",
      "en": "The Lucky Seventh Whistle",
      "zh": "幸運七號哨聲，"
    },
    {
      "ja": "鳴り響く空へ 夢を追いかけて",
      "romaji": "Narihibiku sora e yume o oikakete",
      "en": "Echoes to the sky, chasing after dreams.",
      "zh": "響徹天際，追逐著夢想。"
    },
    {
      "ja": "ずっと ずっと",
      "romaji": "Zutto zutto",
      "en": "Forever and ever,",
      "zh": "永遠永遠，"
    },
    {
      "ja": "この歌を",
      "romaji": "Kono uta o",
      "en": "This song.",
      "zh": "這首歌。"
    }
  ]
