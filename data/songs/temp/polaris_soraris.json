  "lyrics": [
    {
      "ja": "(Instrumental)",
      "romaji": "(Instrumental)",
      "en": "(Instrumental)",
      "zh": "(純音樂)"
    },
    {
      "ja": "遠い昔に見た夢の続きを",
      "romaji": "Tooi mukashi ni mita yume no tsudzuki o",
      "en": "The continuation of a dream I saw long ago",
      "zh": "遙遠過去所見之夢的延續",
      "notes": [
        {
          "word": "夢",
          "meaning": "dream"
        }
      ]
    },
    {
      "ja": "追いかけてたんだ",
      "romaji": "Oikaketeta n da",
      "en": "I was chasing after it",
      "zh": "我一直在追逐著",
      "notes": [
        {
          "word": "追いかけてた",
          "meaning": "was chasing"
        }
      ]
    },
    {
      "ja": "どこまでも続く星の海を",
      "romaji": "Dokomademo tsudzuku hoshi no umi o",
      "en": "The endless sea of stars",
      "zh": "無盡的星海",
      "notes": [
        {
          "word": "星の海",
          "meaning": "sea of stars"
        }
      ]
    },
    {
      "ja": "彷徨いながら",
      "romaji": "Samayoinagara",
      "en": "Wandering through it",
      "zh": "徬徨其中"
    },
    {
      "ja": "迷い込んだ夜空の片隅で",
      "romaji": "Mayoikonda yozora no katasumi de",
      "en": "In a corner of the night sky where I got lost",
      "zh": "在迷失的夜空一隅",
      "notes": [
        {
          "word": "夜空",
          "meaning": "night sky"
        }
      ]
    },
    {
      "ja": "君と出会った",
      "romaji": "Kimi to deatta",
      "en": "I met you",
      "zh": "與你相遇"
    },
    {
      "ja": "ポラリスソラリス 輝く光",
      "romaji": "Porarisu Sorarisu kagayaku hikari",
      "en": "Polaris Solaris, a shining light",
      "zh": "北極星太陽星，閃耀的光芒",
      "notes": [
        {
          "word": "輝く",
          "meaning": "shining"
        }
      ]
    },
    {
      "ja": "導いてくれる",
      "romaji": "Michibiite kureru",
      "en": "Guiding me",
      "zh": "引導著我"
    },
    {
      "ja": "ポラリスソラリス 永遠の願い",
      "romaji": "Porarisu Sorarisu eien no negai",
      "en": "Polaris Solaris, an eternal wish",
      "zh": "北極星太陽星，永恆的願望",
      "notes": [
        {
          "word": "永遠",
          "meaning": "eternal"
        }
      ]
    },
    {
      "ja": "届けたいんだ",
      "romaji": "Todoketai n da",
      "en": "I want to deliver it",
      "zh": "我會傳達"
    }
  ]
}
