  "calls": [],
  "lyrics": [
    {
      "ja": "ゆれる街灯 篠突く雨",
      "romaji": "Yureru gaitou shinotsuku ame",
      "en": "Swaying streetlights, a driving rain",
      "zh": "搖曳的街燈，滂沱的雨",
      "notes": [
        {
          "word": "街灯",
          "meaning": "streetlight"
        }
      ]
    },
    {
      "ja": "傘もささずに 立ち尽くす",
      "romaji": "Kasa mo sasazu ni tachitsukusu",
      "en": "Standing still without an umbrella",
      "zh": "不撐傘地佇立著",
      "notes": [
        {
          "word": "立ち尽くす",
          "meaning": "stand still"
        }
      ]
    },
    {
      "ja": "君の横顔 濡れた髪",
      "romaji": "Kimi no yokogao nureta kami",
      "en": "Your profile, your wet hair",
      "zh": "你的側臉，濕潤的髮絲",
      "notes": [
        {
          "word": "横顔",
          "meaning": "profile"
        }
      ]
    },
    {
      "ja": "何も言えずに 見つめてた",
      "romaji": "Nani mo iezu ni mitsumeteta",
      "en": "I gazed, unable to say anything",
      "zh": "我凝視著，什麼也說不出口",
      "notes": [
        {
          "word": "見つめてた",
          "meaning": "gazed"
        }
      ]
    },
    {
      "ja": "季節はずれの 桜並木",
      "romaji": "Kisetsu hazure no sakura namiki",
      "en": "An out-of-season cherry blossom avenue",
      "zh": "不合時節的櫻花道",
      "notes": [
        {
          "word": "桜並木",
          "meaning": "cherry blossom avenue"
        }
      ]
    },
    {
      "ja": "散りゆく花びら 舞い踊る",
      "romaji": "Chiriyuku hanabira maiodoru",
      "en": "Falling petals dance and flutter",
      "zh": "飄落的花瓣翩翩起舞",
      "notes": [
        {
          "word": "花びら",
          "meaning": "petals"
        }
      ]
    },
    {
      "ja": "まるで僕らの 恋のよう",
      "romaji": "Marude bokura no koi no you",
      "en": "Just like our love"
    }
  ]
}
