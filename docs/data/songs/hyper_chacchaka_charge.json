  "lyrics": [
    {
      "ja": "※ただいま歌詞の翻訳はAIによる生成したものです。人工による翻訳は後ほどアップデートする予定です！",
      "romaji": "",
      "en": "※This translation is currently generated by AI. The refined version is coming soon!",
      "zh": "※此翻譯暫時是AI生成的。人工的翻譯會容後更新！"
    },
    {
      "ja": "高速ハイパーチャッチャカチャージ注入！",
      "romaji": "Kousoku Haipaa Chatchaka Chaaji Chuunyuu!",
      "en": "High-speed hyper-chatchaka charge injection!",
      "zh": "高速超級恰卡恰卡充能注入！"
    },
    {
      "ja": "拝啓　愛しのみなみなさん",
      "romaji": "Haikei Itoshii no Minamina San",
      "en": "Dear beloved everyone",
      "zh": "敬啟，親愛的各位"
    },
    {
      "ja": "お集まりいただき大感謝！",
      "romaji": "Oatsumari Itadaki Daikansha!",
      "en": "Thank you so much for gathering!",
      "zh": "非常感謝大家齊聚一堂！"
    },
    {
      "ja": "山あり谷ありおいといて",
      "romaji": "Yama Ari Tani Ari Oitoite",
      "en": "Setting aside the ups and downs",
      "zh": "把有山有谷的波折先擺一邊"
    },
    {
      "ja": "さぁプラズマの向こうへ",
      "romaji": "Saa Purazuma no Mukou e",
      "en": "Now, to beyond the plasma",
      "zh": "來吧，前往電漿的彼端"
    },
    {
      "ja": "「やっほー！」",
      "romaji": "「Yahhoo!」",
      "en": "\"Yahoo!\"",
      "zh": "「呀呼～！」"
    },
    {
      "ja": "不可能かNOかなんて気にしない",
      "romaji": "Fukanou ka NO ka Nante Ki ni Shinai",
      "en": "I don't care whether it's impossible or a no",
      "zh": "才不在意什麼不可能或 NO"
    },
    {
      "ja": "GOGOGO　五万里の道も一歩から",
      "romaji": "GOGOGO Gomanri no Michi mo Ippo kara",
      "en": "Go, go, go—even a fifty-thousand-mile road starts with one step",
      "zh": "GOGOGO，五萬里之路也從一步開始"
    },
    {
      "ja": "Say　おーらい！おーらい！",
      "romaji": "Say Oorai! Oorai!",
      "en": "Say—all right! All right!",
      "zh": "Say，All right！All right！"
    },
    {
      "ja": "100合目の到来",
      "romaji": "Hyakkai Me no Tourai",
      "en": "The arrival of the hundredth round",
      "zh": "第一百回合的到來"
    },
    {
      "ja": "高速ハイパー…",
      "romaji": "Kousoku Haipaa...",
      "en": "High-speed hyper...",
      "zh": "高速超級……"
    },
    {
      "ja": "っしゅ～",
      "romaji": "Sshu~",
      "en": "Fwoosh~",
      "zh": "咻～"
    },
    {
      "ja": "ど～しよう",
      "romaji": "Doo Shiyou",
      "en": "What should I do?",
      "zh": "該怎麼辦呢"
    },
    {
      "ja": "もうじゅ～でんミリ％なの",
      "romaji": "Mou Juuden Miri Paasento na no",
      "en": "I'm already at a milli-percent charge",
      "zh": "已經只剩充電幾毫％了"
    },
    {
      "ja": "(ナッナッナッナンテコト！！)",
      "romaji": "(Na Na Na Nante Koto!!)",
      "en": "(Wha-wha-wha-what a thing!!)",
      "zh": "（吶吶吶怎麼會這樣！！）"
    },
    {
      "ja": "ど～しようもないことは",
      "romaji": "Dooshou mo Nai Koto ha",
      "en": "Things that can't be helped",
      "zh": "無可奈何的事情"
    },
    {
      "ja": "(ぬーんぬーんぬんぬんぬんぬん)",
      "romaji": "(Nuu N Nuu N Nun Nun Nun Nun)",
      "en": "(Nnn-nnn-nnn-nnn-nnn-nnn)",
      "zh": "（嗯～嗯～嗯嗯嗯嗯嗯嗯）"
    },
    {
      "ja": "パラパッと忘れちゃって",
      "romaji": "Parapatto Wasurechatte",
      "en": "Quickly forget them",
      "zh": "啪啦啪地忘掉吧"
    },
    {
      "ja": "ピリピッと繋げちゃって",
      "romaji": "Piripitto Tsunagechatte",
      "en": "Sharply connect them",
      "zh": "噼哩噼地連繫起來"
    },
    {
      "ja": "はっちゃけちゃって",
      "romaji": "Hatchakechatte",
      "en": "Go wild",
      "zh": "盡情放縱"
    },
    {
      "ja": "とばしちゃって",
      "romaji": "Tobashichatte",
      "en": "Let it fly",
      "zh": "讓它飛出去"
    },
    {
      "ja": "よいよいよい！",
      "romaji": "Yoi Yoi Yoi!",
      "en": "Yoi, yoi, yoi!",
      "zh": "喲咿喲咿喲咿！"
    },
    {
      "ja": "ハイハイハイパーチャッチャカチャージで",
      "romaji": "Hai Hai Haipaa Chatchaka Chaaji de",
      "en": "With high-high-hyper-chatchaka charge",
      "zh": "用嗨嗨超級恰卡恰卡充能"
    },
    {
      "ja": "こんがらがったシグナルかっとばせ",
      "romaji": "Kongaragatta Shigunaru Kattobase",
      "en": "Knock the tangled signals flying",
      "zh": "把糾纏不清的訊號一擊打飛"
    },
    {
      "ja": "ハイハイハイパーチャッチャカチャレンジ",
      "romaji": "Hai Hai Haipaa Chatchaka Charenji",
      "en": "High-high-hyper-chatchaka challenge",
      "zh": "嗨嗨超級恰卡恰卡挑戰"
    },
    {
      "ja": "ミラクルみせます",
      "romaji": "Mirakuru Misemasu",
      "en": "I'll show you a miracle",
      "zh": "讓你見識奇蹟"
    },
    {
      "ja": "Make it Make itついてきて",
      "romaji": "Make It Make It Tsuite Kite",
      "en": "Make it, make it—come follow me",
      "zh": "Make it Make it，跟上來吧"
    },
    {
      "ja": "しっかりお水飲んでねっ！",
