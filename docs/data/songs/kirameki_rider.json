      "romaji": "Kasoku Suru Haato",
      "en": "My accelerating heart",
      "zh": "加速的心"
    },
    {
      "ja": "(いっしょに)",
      "romaji": "(Issho ni)",
      "en": "(Together)",
      "zh": "（一起）"
    },
    {
