      "en": "The best time, with the best friends",
      "zh": "最棒的時光，與最棒的夥伴"
    },
    {
      "ja": "キラメキに乗って☆",
      "romaji": "Kirameki ni Notte☆",
      "en": "Riding on the sparkle☆",
      "zh": "乘著閃耀☆"
    },
    {
      "ja": "(イェーイ)",
      "romaji": "(Yeei)",
      "en": "(Yay)",
      "zh": "（耶）"
    },
    {
      "ja": "覚えてるかな？",
      "romaji": "Oboeteru Kana?",
      "en": "Do you remember?",
      "zh": "還記得嗎？"
