    },
    {
      "ja": "約束した今日の日を",
      "romaji": "Yakusoku Shita Kyou no Hi wo",
      "en": "This promised day",
      "zh": "約定好的今天"
    },
    {
      "ja": "一生忘れない そんな気がした",
      "romaji": "Isshou Wasurenai Sonna Ki ga Shita",
      "en": "I felt I'd never forget it for the rest of my life",
      "zh": "感覺一輩子都不會忘記"
    },
    {
      "ja": "ユメゾラの真下で",
      "romaji": "Yumezora no Mashita de",
      "en": "Right under the dream sky",
      "zh": "在夢之天空的正下方"
    },
    {
      "ja": "「あの空の向こう側",
      "romaji": "「Ano Sora no Mukou Gawa",
      "en": "\"Beyond that sky",
      "zh": "「那片天空的彼端"
    },
    {
      "ja": "行ってみたいな」って",
      "romaji": "Itte Mitai na」 tte",
      "en": "I want to go there\"",
      "zh": "好想去看看啊」"
    },
    {
      "ja": "覗き込んだ望遠鏡",
      "romaji": "Nozokikonda Bouenkyou",
      "en": "I peered through a telescope",
      "zh": "窺探著望遠鏡"
    },
    {
      "ja": "宝探しみたいだ",
      "romaji": "Takara Sagashi Mitai Da",
      "en": "It's like a treasure hunt",
      "zh": "就像在尋寶一樣"
    },
    {
      "ja": "「好き」が夢をかなえるって",
      "romaji": "「Suki」 ga Yume wo Kanaeru tte",
      "en": "They said \"love\" makes dreams come true",
      "zh": "有人說過「喜歡」能實現夢想"
    },
    {
      "ja": "誰かが言ってた",
      "romaji": "Dareka ga Itteta",
      "en": "Someone once said that",
      "zh": "某人曾這麼說"
    },
    {
      "ja": "思いっきり泣いたり笑ったり",
      "romaji": "Omoikkiri Naitari Warattari",
      "en": "Crying and laughing with all your heart",
      "zh": "盡情地哭泣、盡情地歡笑"
    },
    {
      "ja": "全速前進でしょ？",
      "romaji": "Zensoku Zenshin Desho?",
      "en": "It's full speed ahead, right?",
      "zh": "就是全速前進對吧？"
    },
    {
      "ja": "あぁ夜明けが",
      "romaji": "Aa Yoake ga",
      "en": "Ah, when the dawn",
      "zh": "啊，當黎明"
    },
    {
      "ja": "星座を追い越した時",
      "romaji": "Seiza wo Oikoshita Toki",
      "en": "Overtook the constellations",
      "zh": "追過了星座的那一刻"
    },
    {
      "ja": "流れる星が光った",
      "romaji": "Nagareru Hoshi ga Hikatta",
      "en": "A shooting star sparkled",
      "zh": "流星閃耀發光"
    },
    {
      "ja": "一つだけ願うのなら",
      "romaji": "Hitotsu Dake Negau no Nara",
      "en": "If I could make just one wish",
      "zh": "如果只能許一個願"
    },
    {
      "ja": "夢が叶う瞬間",
      "romaji": "Yume ga Kanau Shunkan",
      "en": "At the moment my dream comes true",
      "zh": "在夢想實現的瞬間"
    },
    {
      "ja": "そばにいてくれますか？",
      "romaji": "Soba ni Ite Kuremasu ka?",
      "en": "Will you stay by my side?",
      "zh": "你願意陪在我身邊嗎？"
    },
    {
      "ja": "見に行こう",
      "romaji": "Mi ni Ikou",
      "en": "Let's go see it",
      "zh": "一起去看看吧"
    },
    {
      "ja": "ハッピーエンドのファンファーレ",
      "romaji": "Happii Endo no Fanfaare",
      "en": "The fanfare of a happy ending",
      "zh": "快樂結局的號角聲"
    },
    {
      "ja": "キラキラの未来へ",
      "romaji": "Kira Kira no Mirai e",
      "en": "To a sparkling future",
      "zh": "前往閃閃發光的未來"
    },
    {
      "ja": "星に負けない光と",
      "romaji": "Hoshi ni Makenai Hikari to",
      "en": "With a light that won't lose to the stars",
      "zh": "用不輸給星辰的光芒"
    },
    {
      "ja": "高鳴る希望 響かせ",
      "romaji": "Takanaru Kibou Hibikase",
      "en": "Letting resounding hope ring out",
      "zh": "讓高亢的希望響徹"
    },
    {
      "ja": "涙と涙が重なって",
      "romaji": "Namida to Namida ga Kasanatte",
      "en": "When tears overlap with tears",
      "zh": "眼淚與眼淚交疊"
    },
    {
      "ja": "空が明けるように",
      "romaji": "Sora ga Akeru You ni",
      "en": "Like the sky growing bright",
      "zh": "宛如天空破曉"
    },
    {
      "ja": "夢と夢がギュッと",
      "romaji": "Yume to Yume ga Gyutto",
      "en": "When dreams tightly",
      "zh": "夢想與夢想緊緊"
    },
    {
      "ja": "重なる瞬間を 奇跡と呼ぶんだ",
      "romaji": "Kasanaru Shunkan wo Kiseki to Yobu n Da",
      "en": "Overlap—that's what we call a miracle",
      "zh": "交疊的瞬間，就叫做奇蹟"
    },
    {
      "ja": "着地点はいつだって",
      "romaji": "Chakuchiten ha Itsu Datte",
      "en": "My landing point is always",
      "zh": "落腳點永遠都是"
    },
    {
      "ja": "キミのその笑顔",
      "romaji": "Kimi no Sono Egao",
      "en": "That smile of yours",
      "zh": "你的那個笑容"
    },
    {
      "ja": "遠回りしたけど出会えたんだ",
      "romaji": "Toomawari Shita kedo Deaeta n Da",
      "en": "We took the long way, but we met",
      "zh": "雖然繞了遠路，但我們相遇了"
    },
    {
      "ja": "一生一緒でしょ？",
      "romaji": "Isshou Issho Desho?",
      "en": "We'll be together forever, right?",
      "zh": "一輩子都在一起對吧？"
    },
    {
      "ja": "きらめく",
      "romaji": "Kirameku",
      "en": "Sparkling",
      "zh": "閃爍的"
    },
    {
      "ja": "希望のメロディー描いて",
      "romaji": "Kibou no Merodii Egaite",
      "en": "Drawing a melody of hope",
      "zh": "描繪希望的旋律"
    },
    {
      "ja": "夢に会いに行こう",
      "romaji": "Yume ni Ai ni Ikou",
      "en": "Let's go meet our dreams",
      "zh": "去與夢想相見吧"
    },
    {
      "ja": "無数の星屑の中",
      "romaji": "Musuu no Hoshikuzu no Naka",
      "en": "Among countless stardust",
      "zh": "在無數的星塵之中"
    },
    {
      "ja": "見つけてくれてありがとう",
      "romaji": "Mitsukete Kurete Arigatou",
      "en": "Thank you for finding me",
      "zh": "謝謝你找到了我"
    },
    {
      "ja": "大切なキミへいつの日でも",
      "romaji": "Taisetsu na Kimi e Itsu no Hi demo",
      "en": "To my precious you, any day at all",
      "zh": "無論何時，都要傳給最重要的你"
    },
    {
      "ja": "一番に届けよう",
      "romaji": "Ichiban ni Todokeyou",
      "en": "I'll deliver it to you first",
      "zh": "第一個傳達給你"
    },
    {
      "ja": "見 て て 私ここで",
      "romaji": "Mi Te Te Watashi Koko de",
      "en": "Watch me—right here",
      "zh": "要看著喔，我就在這裡"
    },
    {
