  "lyrics": [
    {
      "ja": "※ただいま歌詞の翻訳はAIによる生成したものです。人工による翻訳は後ほどアップデートする予定です！",
      "romaji": "",
      "en": "※This translation is currently generated by AI. The refined version is coming soon!",
      "zh": "※此翻譯暫時是AI生成的。人工的翻譯會容後更新！"
    },
    {
      "ja": "アイガタリネーナ",
      "romaji": "Aigatari Neena",
      "en": "Love-telling Neena",
      "zh": "愛的故事呢吶"
    },
    {
      "ja": "コワレチャッテラナビゲーター",
      "romaji": "Kowarechattera Nabigeetaa",
      "en": "The navigator's broken down",
      "zh": "壞掉了的導航員"
    },
    {
      "ja": "ナンカアイガタリネーナ",
      "romaji": "Nanka Aigatari Neena",
      "en": "Somehow love-telling Neena",
      "zh": "總覺得愛的故事呢吶"
    },
    {
      "ja": "コワレチャッテラナビゲーター",
      "romaji": "Kowarechattera Nabigeetaa",
      "en": "The navigator's broken down",
      "zh": "壞掉了的導航員"
    },
    {
      "ja": "こんな真っ暗　海の中",
      "romaji": "Konna Makkura Umi no Naka",
      "en": "In such a pitch-black sea",
      "zh": "在如此漆黑的海中"
    },
    {
      "ja": "外もプライベートも　クルクル回って",
      "romaji": "Soto mo Puraibeeto mo Kurukuru Mawatte",
      "en": "Both the outside and private life spin round and round",
      "zh": "外在也好私人也好，都在團團轉"
    },
    {
      "ja": "惚けた惰性に　抵抗もできずに流れてく",
      "romaji": "Boketa Dasei ni Teikou mo Dekizu ni Nagareteku",
      "en": "Drifting along, unable to resist the dull inertia",
      "zh": "無法抵抗痴呆的慣性，隨波逐流"
    },
    {
      "ja": "(No No)　相対的に見れば",
      "romaji": "(No No) Soutaiteki ni Mireba",
      "en": "(No, no) Looking at it relatively",
      "zh": "（No No）從相對的角度來看"
    },
    {
      "ja": "(No No)　キミとボクの時間は",
      "romaji": "(No No) Kimi to Boku no Jikan ha",
      "en": "(No, no) Your time and mine",
      "zh": "（No No）你和我的時間"
    },
    {
      "ja": "(No No)　違って　なんかボクだけ焦ってた",
      "romaji": "(No No) Chigatte Nanka Boku Dake Asetteta",
      "en": "(No, no) Are different—somehow only I was impatient",
      "zh": "（No No）並不相同，總覺得只有我在焦急"
    },
    {
      "ja": "ウワウワウワ",
      "romaji": "Uwa Uwa Uwa",
      "en": "Whoa whoa whoa",
      "zh": "嗚哇嗚哇嗚哇"
    },
    {
      "ja": "気を抜くとすぐに",
      "romaji": "Ki wo Nuku to Sugu ni",
      "en": "The moment I let my guard down",
      "zh": "一鬆懈下來"
    },
    {
      "ja": "歪んだ重力場",
      "romaji": "Yuganda Juuryokuba",
      "en": "A distorted gravitational field",
      "zh": "扭曲的重力場"
    },
    {
      "ja": "何もかも飲み込んでよ",
      "romaji": "Nanimo Kamo Nomikonde yo",
      "en": "Swallow everything up",
      "zh": "把一切都吞噬吧"
    },
    {
      "ja": "Hey Hey　恋愛コスモロジー",
      "romaji": "Hey Hey Ren'ai Kosumorojii",
      "en": "Hey, hey—love cosmology",
      "zh": "Hey Hey，戀愛宇宙論"
    },
    {
      "ja": "常識がもうずっとバグってんだ",
      "romaji": "Joushiki ga Mou Zutto Bagutten Da",
      "en": "Common sense has been bugged all along",
      "zh": "常識早就一直故障了"
    },
    {
      "ja": "果てのない自問自答",
      "romaji": "Hate no Nai Jimon Jitou",
      "en": "Endless self-questioning",
      "zh": "無止盡的自問自答"
    },
    {
      "ja": "壊して　キミの引力で",
      "romaji": "Kowashite Kimi no Inryoku de",
      "en": "Break it—with your gravity",
      "zh": "破壞吧，用你的引力"
    },
    {
      "ja": "バイバイ　テクノロジー",
      "romaji": "Baibai Tekunorojii",
      "en": "Bye-bye, technology",
      "zh": "掰掰，科技"
    },
    {
      "ja": "叡智なんてとっくに超えて　無限に",
      "romaji": "Eichi Nante Tokkuni Koete Mugen ni",
      "en": "Far surpassing wisdom—infinitely",
      "zh": "早已超越了睿智，無限地"
    },
    {
      "ja": "Ah",
      "romaji": "Ah",
      "en": "Ah",
      "zh": "Ah"
    },
    {
      "ja": "愛し合いてぇだけだわ",
      "romaji": "Aishiaitetee Dake Da wa",
      "en": "I just want to love each other",
      "zh": "只是想要相愛罷了"
    },
    {
      "ja": "ゆっくり髪をかき上げる",
      "romaji": "Yukkuri Kami wo Kakiageru",
      "en": "Slowly brushing up my hair",
      "zh": "慢慢地撩起頭髮"
    },
    {
      "ja": "キミを見ては鼓動　速くなる",
      "romaji": "Kimi wo Mite ha Kodou Hayaku Naru",
      "en": "Looking at you, my heartbeat quickens",
      "zh": "看著你，心跳就加速"
    },
    {
      "ja": "(No No)　ずっと昔から",
      "romaji": "(No No) Zutto Mukashi kara",
      "en": "(No, no) Since long, long ago",
      "zh": "（No No）從很久以前開始"
    },
    {
      "ja": "(No No)　続く最大の謎を",
      "romaji": "(No No) Tsuzuku Saidai no Nazo wo",
      "en": "(No, no) The greatest mystery that continues",
      "zh": "（No No）持續存在的最大謎團"
    },
    {
      "ja": "(No No)　みんな放置して愛し合ってさ",
      "romaji": "(No No) Minna Houchi Shite Aishiatte sa",
      "en": "(No, no) Everyone leaves it alone and loves each other",
      "zh": "（No No）大家都擱置不管，只管相愛"
    },
    {
      "ja": "ウワウワウワ",
