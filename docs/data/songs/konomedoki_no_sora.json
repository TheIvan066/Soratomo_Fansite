  "lyrics": [
      {
      "ja": "見渡した瞳に映る青空",
      "romaji": "Mawatashita Hitomi ni Utsuru Aozora",
      "en": "The blue sky reflected in my eyes as I gazed upon the horizon",
      "zh": "眺望着遠方，雙眸裏映照著藍天"
    },
    {
      "ja": "霞みかけだけれど",
      "romaji": "Kasumi Kakeda keredo",
      "en": "Although it is hazy ahead",
      "zh": "縱使前方滿是陰霾"
    },
    {
      "ja": "踏み出してみようか",
      "romaji": "Fumidashite Miyou ka",
      "en": "I shall still try taking a step forward",
      "zh": "還是試著邁出步伐吧"
    },
    {
      "ja": "透き通ったキャンバス",
      "romaji": "Sukitootta Kyanbasu",
      "en": "The crystal clear canvas",
      "zh": "通透的畫布"
    },
    {
      "ja": "これからの形",
      "romaji": "Korekara no Katachi",
      "en": "and the shape it is going to become -",
      "zh": "它未來的形狀"
    },
    {
      "ja": "忘れたりしないよ",
      "romaji": "Wasuretari Shinai yo",
      "en": "I will never forget it",
      "zh": "我絕對不會忘記啊"
    },
    {
      "ja": "それが私だよ",
      "romaji": "Sore ga Watashi dayo",
      "en": "That is who I am",
      "zh": "那就是我啊"
    },
    {
      "ja": "時計は流されぐるぐる回る",
      "romaji": "Tokei ha Nagasare Guruguru Mawaru",
      "en": "The clock ticks along, spinning round and round",
      "zh": "時針隨時間流轉滴答滴答地轉動"
    },
    {
      "ja": "足跡数えて靴紐結ぶ",
      "romaji": "Ashiato Kazoete Kutsuhimo Musubu",
      "en": "Counting footprints as I tied my shoelaces",
      "zh": "細數著腳印，繋好鞋帶"
    },
    {
      "ja": "花ひらり開いてくよ",
      "romaji": "Hana Hirari Hiraiteku yo",
      "en": "Flowers bloom as they flutter",
      "zh": "花兒翩翩綻放開來"
    },
    {
      "ja": "寒空でも愛せるよ",
      "romaji": "Samazora demo Aiseru yo",
      "en": "I can adore even under a freezing sky",
      "zh": "即使在寒空之下也令人憐愛"
    },
    {
      "ja": "そらへ駆けてく",
      "romaji": "Sora he Kaketeku",
      "en": "Dashing towards the sky",
      "zh": "奔向天空"
    },
    {
      "ja": "ときを生きてる",
      "romaji": "Toki wo Ikiteru",
      "en": "Living in this moment",
      "zh": "活在頃刻"
    },
    {
      "ja": "止まらないよ私",
      "romaji": "Tomaranai yo Watashi",
      "en": "Never would I stop, ever",
      "zh": "我是不會停下來的啊"
    },
    {
      "ja": "あなたのことも知ってるよ",
      "romaji": "Anata no Koto mo Shitteru yo",
      "en": "I know about you too",
      "zh": "我也知道你的事情喔"
    },
    {
      "ja": "優しい言葉知ってるよ",
      "romaji": "Yasashii Kotoba Shitteru yo",
      "en": "I also know the kind words you say",
      "zh": "也知道你所說過的溫柔話語"
    },
    {
      "ja": "遠回りでも荒れた道でも",
      "romaji": "Toomawari demo Areta Michi demo",
      "en": "Even if it's a detour; even if it's a rough road",
      "zh": "縱使是迂回的遠路 或是崎嶇的荒路"
    },
    {
      "ja": "歩いてきて良かったなぁ",
      "romaji": "Aruite Kite Yokatta naa",
      "en": "I'm so glad we traversed it all the way here",
      "zh": "能一路走過來真是太好了呢"
    },
    {
      "ja": "見とれた星影にかざす手のひら",
      "romaji": "Mitoreta Hoshikage ni Kazasu Tenohira",
      "en": "Holding up my palm against the mesmerizing starlight",
      "zh": "將手掌高舉向着令人著迷的星光"
    },
    {
      "ja": "とめどなく溢れた",
      "romaji": "Tomedonaku Afureta",
      "en": "Overflowing endlessly are",
      "zh": "繁星間源源不絕地湧出"
    },
    {
      "ja": "深い空の色",
      "romaji": "Fukai Sora no Iro",
      "en": "the deep colors of the sky",
      "zh": "深邃的天空色彩"
    },
    {
      "ja": "思えばどんな日も",
      "romaji": "Omoeba Donna Hi mo",
      "en": "Looking back, no matter what kind of day it was,",
      "zh": "回想起來，無論哪一天"
    },
    {
      "ja": "ピースのようで",
      "romaji": "Piisu no You de",
      "en": "they were all puzzle pieces",
      "zh": "都像是拼圖的一塊"
    },
    {
      "ja": "私は私だと",
