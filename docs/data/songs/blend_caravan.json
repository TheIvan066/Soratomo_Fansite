  "lyrics": [
    {
      "ja": "※ただいま歌詞の翻訳はAIによる生成したものです。人工による翻訳は後ほどアップデートする予定です！",
      "romaji": "",
      "en": "※This translation is currently generated by AI. The refined version is coming soon!",
      "zh": "※此翻譯暫時是AI生成的。人工的翻譯會容後更新！"
    },
    {
      "ja": "楽しさに釣られ",
      "romaji": "Tanoshisa ni Tsurare",
      "en": "Drawn in by the fun",
      "zh": "被快樂所吸引"
    },
    {
      "ja": "うっかり参加したら",
      "romaji": "Ukkari Sanka Shitara",
      "en": "When I carelessly joined in",
      "zh": "一不小心就參加了"
    },
    {
      "ja": "知らないあれや",
      "romaji": "Shiranai Are ya",
      "en": "Unknown things, this and that",
      "zh": "未曾知曉的種種事物"
    },
    {
      "ja": "これ巡り合った",
      "romaji": "Kore Meguri Atta",
      "en": "I came across them all",
      "zh": "就這樣與它們相遇"
    },
    {
      "ja": "大変な挑戦も",
      "romaji": "Taihen na Chousen mo",
      "en": "Even tough challenges",
      "zh": "無論是艱鉅的挑戰"
    },
    {
      "ja": "のんびり休息も",
      "romaji": "Nonbiri Kyuusoku mo",
      "en": "And leisurely rests",
      "zh": "還是悠閒的休息"
    },
    {
      "ja": "支え合って想い",
      "romaji": "Sasae Atte Omoi",
      "en": "Supporting each other, our feelings",
      "zh": "彼此扶持的心意"
    },
    {
      "ja": "伝染した",
      "romaji": "Densen Shita",
      "en": "Spread like a contagion",
      "zh": "相互傳染開來"
    },
    {
      "ja": "未開拓でも前を向いて",
      "romaji": "Mikaitaku demo Mae wo Muite",
      "en": "Even uncharted, face forward",
      "zh": "即使尚未開拓，也要向前看"
    },
    {
      "ja": "小さな行進 重ねた",
      "romaji": "Chiisana Koushin Kasaneta",
      "en": "We layered small marches together",
      "zh": "累積了一次次小小的行進"
    },
    {
      "ja": "絶えず途切れない",
      "romaji": "Taezu Togirenai",
      "en": "Never ending, uninterrupted",
      "zh": "永不斷絕"
    },
    {
      "ja": "笑い声の中を進んでこう",
      "romaji": "Waraigoe no Naka wo Susundekou",
      "en": "Let's keep moving forward amid the laughter",
      "zh": "在笑聲之中繼續前進吧"
    },
    {
      "ja": "さぁ 教えてほら全部",
      "romaji": "Saa Oshiete Hora Zenbu",
      "en": "Come on, tell me—look, everything",
      "zh": "來吧，告訴我，對，全部"
    },
    {
      "ja": "何回時計の針",
      "romaji": "Nankai Tokei no Hari",
      "en": "No matter how many times the clock hands",
      "zh": "無論時鐘的指針"
    },
    {
      "ja": "ぐるぐる回っても話を聞くよ",
      "romaji": "Guruguru Mawatte mo Hanashi wo Kiku yo",
      "en": "Spin around and around, I'll listen to you",
      "zh": "轉了多少圈，我都會傾聽"
    },
    {
      "ja": "まだまだ終わらない",
      "romaji": "Mada Mada Owaranai",
      "en": "It's still far from over",
      "zh": "還遠遠不會結束"
    },
    {
      "ja": "この夢がきっと",
      "romaji": "Kono Yume ga Kitto",
      "en": "This dream will surely",
      "zh": "這個夢想必定"
    },
    {
      "ja": "ずっと永遠に",
      "romaji": "Zutto Eien ni",
      "en": "Forever and ever",
      "zh": "永遠長存"
    },
    {
      "ja": "褪せることのない",
      "romaji": "Aseru Koto no Nai",
      "en": "Unfading",
      "zh": "永不褪色"
    },
    {
      "ja": "時を君にくれる",
      "romaji": "Toki wo Kimi ni Kureru",
      "en": "It will give you time",
      "zh": "將時光贈予你"
    },
    {
      "ja": "訪れた先で",
      "romaji": "Otozureta Saki de",
      "en": "At the places I visited",
      "zh": "在到訪的地方"
    },
    {
      "ja": "歓迎増えて行く",
      "romaji": "Kangei Fuete Iku",
      "en": "Welcomes keep increasing",
      "zh": "歡迎不斷增多"
    },
    {
      "ja": "すれ違った風に",
      "romaji": "Surechigatta Kaze ni",
      "en": "From the wind that passed by",
      "zh": "從擦身而過的風中"
    },
    {
      "ja": "聞いたみたい",
      "romaji": "Kiita Mitai",
      "en": "It's as if I heard it",
      "zh": "彷彿聽到了什麼"
    },
    {
      "ja": "そうして世界中を",
      "romaji": "Soushite Sekaijuu wo",
      "en": "And so, around the whole world",
      "zh": "就這樣將整個世界"
    },
    {
      "ja": "巻き込んで大行進",
      "romaji": "Makikonde Daikoushin",
      "en": "A grand march that sweeps everyone in",
      "zh": "捲入這場大遊行"
    },
    {
      "ja": "一人また一人",
      "romaji": "Hitori Mata Hitori",
      "en": "One by one, more and more people",
      "zh": "一個又一個人"
    },
    {
      "ja": "加わった",
      "romaji": "Kuwawatta",
      "en": "Joined in",
      "zh": "加入了進來"
    },
    {
      "ja": "直観頼って",
      "romaji": "Chokkan Tayotte",
      "en": "Relying on intuition",
      "zh": "憑藉直覺"
    },
    {
      "ja": "街を探す",
      "romaji": "Machi wo Sagasu",
      "en": "Searching the town",
      "zh": "尋覓街道"
    },
    {
      "ja": "双眼鏡覗いても",
      "romaji": "Sougankyou Nozoite mo",
      "en": "Even peering through binoculars",
      "zh": "即使舉起望遠鏡窺看"
    },
    {
      "ja": "わからない",
      "romaji": "Wakaranai",
      "en": "I can't tell",
      "zh": "也無法明白"
    },
    {
      "ja": "迷っているのも",
      "romaji": "Mayotte Iru no mo",
      "en": "Even being lost",
      "zh": "即使迷惘徬徨"
    },
    {
      "ja": "それが醍醐味なんだって",
      "romaji": "Sore ga Daigomi Nan Datte",
      "en": "They say that's part of the fun",
      "zh": "據說那正是樂趣所在"
    },
    {
      "ja": "言っていこう",
      "romaji": "Itte Ikou",
      "en": "Let's keep saying it",
      "zh": "就這樣說下去吧"
    },
    {
      "ja": "ねぇ 沢山の思い出を",
      "romaji": "Nee Takusan no Omoide wo",
      "en": "Hey, all these many memories",
      "zh": "吶，將許許多多的回憶"
    },
    {
      "ja": "こぼさずきつく縛って",
      "romaji": "Kobosazu Kitsuku Shibatte",
      "en": "Without spilling any, tie them tightly",
      "zh": "一滴不漏地牢牢捆起"
    },
    {
      "ja": "がらがら大切に運び続ける",
      "romaji": "Garagara Taisetsu ni Hakobi Tsuzukeru",
      "en": "Rumbling along, I keep carrying them with care",
      "zh": "轟隆隆地珍惜搬運下去"
    },
    {
      "ja": "出会えた瞬間に",
      "romaji": "Deaeta Shunkan ni",
      "en": "At the moment we meet",
      "zh": "在相遇的瞬間"
    },
    {
      "ja": "こんな場所だよって",
