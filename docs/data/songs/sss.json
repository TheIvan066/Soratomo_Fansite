  "lyrics": [
    {
      "ja": "※ただいま歌詞の翻訳はAIによる生成したものです。人工による翻訳は後ほどアップデートする予定です！",
      "romaji": "",
      "en": "※This translation is currently generated by AI. The refined version is coming soon!",
      "zh": "※此翻譯暫時是AI生成的。人工的翻譯會容後更新！"
    },
    {
      "ja": "同じ未来を見ていたい",
      "romaji": "Onaji Mirai wo Mite Itai",
      "en": "I want to see the same future",
      "zh": "想看著相同的未來"
    },
    {
      "ja": "あの夢手にしたい",
      "romaji": "Ano Yume Te ni Shitai",
      "en": "I want to hold that dream in my hands",
      "zh": "想將那個夢想握在手中"
    },
    {
      "ja": "それぞれ 違った",
      "romaji": "Sorezore Chigatta",
      "en": "Each with different hearts",
      "zh": "各自懷著不同的心"
    },
    {
      "ja": "ココロで 走れ go!",
      "romaji": "Kokoro de Hashire Go!",
      "en": "Run with your heart—go!",
      "zh": "用心奔跑，go！"
    },
    {
      "ja": "どこを見ても真っ暗な",
      "romaji": "Doko wo Mite mo Makkura na",
      "en": "In a place that was pitch-black no matter where I looked",
      "zh": "無論看向何處都是一片漆黑的地方"
    },
    {
      "ja": "場所に芽生えてた",
      "romaji": "Basho ni Mebaeteta",
      "en": "There, a tiny hope had sprouted",
      "zh": "在那裡萌芽了"
    },
    {
      "ja": "ほんの小さな希望に",
      "romaji": "Honno Chiisana Kibou ni",
      "en": "My eyes were stolen away",
      "zh": "被那微小的希望"
    },
    {
      "ja": "この瞳奪われた",
      "romaji": "Kono Hitomi Ubawareta",
      "en": "By that tiny hope",
      "zh": "奪去了目光"
    },
    {
      "ja": "不安で揺れる心を",
      "romaji": "Fuan de Yureru Kokoro wo",
      "en": "I tuned my heart",
      "zh": "將因不安而搖曳的心"
    },
    {
      "ja": "上手くチューニングして",
      "romaji": "Umaku Chuuningu Shite",
      "en": "That wavered with anxiety",
      "zh": "好好地調整"
    },
    {
      "ja": "ほんの小さな勇気を",
      "romaji": "Honno Chiisana Yuuki wo",
      "en": "And squeezed out",
      "zh": "擠出了"
    },
    {
      "ja": "振り絞っていたよ",
      "romaji": "Furishibotte Ita yo",
      "en": "Just a tiny bit of courage",
      "zh": "微小的勇氣"
    },
    {
      "ja": "諦めの文字",
      "romaji": "Akirame no Moji",
      "en": "I delete the word \"giving up\"",
      "zh": "將放棄二字"
    },
    {
      "ja": "デリートして進む",
      "romaji": "Deriito Shite Susumu",
      "en": "And move forward",
      "zh": "刪除後繼續前進"
    },
    {
      "ja": "苦しいときも",
      "romaji": "Kurushii Toki mo",
      "en": "Even in painful times",
      "zh": "痛苦的時候也好"
    },
    {
      "ja": "もう私は ひとりじゃないから",
      "romaji": "Mou Watashi ha Hitori ja Nai kara",
      "en": "Because I'm no longer alone",
      "zh": "因為我已經不是一個人了"
    },
    {
      "ja": "だからもっと夢追いかけたい",
      "romaji": "Dakara Motto Yume Oikaketai",
      "en": "So I want to chase my dream even more",
      "zh": "所以想更加追逐夢想"
    },
    {
      "ja": "ワクワク止まらない",
      "romaji": "Wakuwaku Tomaranai",
      "en": "The excitement won't stop",
      "zh": "興奮停不下來"
    },
    {
      "ja": "想像 越えてく",
      "romaji": "Souzou Koeteku",
      "en": "I'll show you a world beyond imagination",
      "zh": "帶你去看超越想像的世界"
    },
    {
      "ja": "世界見せてあげる",
      "romaji": "Sekai Misete Ageru",
      "en": "I'll show you a world",
      "zh": "讓你看看"
    },
    {
      "ja": "アクセスしてみたい",
      "romaji": "Akusesu Shite Mitai",
      "en": "I want to try accessing it",
      "zh": "好想試著去連結"
    },
    {
      "ja": "後悔なんてそうさせない",
      "romaji": "Koukai Nante Sou Sasenai",
      "en": "I won't let you have regrets",
      "zh": "不會讓你有任何後悔"
    },
    {
      "ja": "それぞれ 違った",
      "romaji": "Sorezore Chigatta",
      "en": "Each with different hearts",
      "zh": "各自懷著不同的心"
    },
    {
      "ja": "ココロで 走れ go!",
      "romaji": "Kokoro de Hashire Go!",
      "en": "Run with your heart—go!",
      "zh": "用心奔跑，go！"
    },
    {
      "ja": "仮想の空に輝く",
      "romaji": "Kasou no Sora ni Kagayaku",
      "en": "These dazzling feelings shining in a virtual sky",
      "zh": "在虛擬天空中閃耀的"
    },
    {
      "ja": "眩しい想いは",
      "romaji": "Mabushii Omoi ha",
      "en": "Deliver a light I've never seen",
      "zh": "耀眼情感"
    },
    {
      "ja": "見たことのない光を",
      "romaji": "Mita Koto no Nai Hikari wo",
      "en": "Into reality",
      "zh": "將前所未見的光芒"
    },
    {
      "ja": "現実に届ける",
      "romaji": "Genjitsu ni Todokeru",
      "en": "Those dazzling feelings",
      "zh": "傳遞到現實"
    },
    {
      "ja": "いつも聞こえるエールは",
      "romaji": "Itsumo Kikoeru Eeru ha",
      "en": "I capture the cheers I always hear",
      "zh": "將總是傳來的聲援"
    },
    {
      "ja": "ここにキャプチャーして",
      "romaji": "Koko ni Kyapuchaa Shite",
      "en": "Right here",
      "zh": "捕捉於此"
    },
    {
      "ja": "また新しい光を",
      "romaji": "Mata Atarashii Hikari wo",
      "en": "And I want to search for a new light again",
