    },
    {
      "ja": "吹き抜ける　夏の風",
      "romaji": "Fukinukeru Natsu no Kaze",
      "en": "The summer wind blows through",
      "zh": "吹拂而過的夏日之風"
    },
    {
      "ja": "背中を押す　青空",
      "romaji": "Senaka wo Osu Aozora",
      "en": "The blue sky pushes me forward",
      "zh": "藍天在背後輕輕推動"
    },
    {
      "ja": "眩しすぎる　笑顔見せて",
      "romaji": "Mabushi Sugiru Egao Misete",
      "en": "Show me a smile that's too dazzling",
      "zh": "露出那過於耀眼的笑容"
    },
    {
      "ja": "青空のステージへ",
      "romaji": "Aozora no Suteeji e",
      "en": "To the stage of the blue sky",
      "zh": "前往藍天的舞台"
    },
    {
      "ja": "せーの！",
      "romaji": "Seeno!",
      "en": "Ready, set!",
      "zh": "預備，起！"
    },
    {
      "ja": "青空ラビッツ",
      "romaji": "Aozora Rabittsu",
      "en": "Blue-sky rabbits",
      "zh": "藍天小兔子"
    },
    {
      "ja": "青空ラビッツ",
      "romaji": "Aozora Rabittsu",
      "en": "Blue-sky rabbits",
      "zh": "藍天小兔子"
    },
    {
      "ja": "青空ラビッツ",
      "romaji": "Aozora Rabittsu",
      "en": "Blue-sky rabbits",
      "zh": "藍天小兔子"
    },
    {
      "ja": "ぴょんぴょんぴょんぴょん",
      "romaji": "Pyon Pyon Pyon Pyon",
      "en": "Hop, hop, hop, hop",
      "zh": "蹦蹦蹦蹦"
    },
    {
      "ja": "ぴょんぴょん",
      "romaji": "Pyon Pyon",
      "en": "Hop, hop",
      "zh": "蹦蹦"
    },
    {
      "ja": "空色制服にリボン",
      "romaji": "Sorairo Seifuku ni Ribon",
      "en": "A sky-blue uniform with a ribbon",
      "zh": "天藍色制服配上蝴蝶結"
    },
    {
      "ja": "ロングヘア　５月生まれ",
      "romaji": "Rongu Hea Gogatsu Umare",
      "en": "Long hair, born in May",
      "zh": "長髮，五月出生"
    },
    {
      "ja": "そんなときのそらちゃんから",
      "romaji": "Sonna Toki no Sora Chan kara",
      "en": "From Sora-chan, who's like that",
      "zh": "從那樣的小空那裡"
    },
    {
      "ja": "響木　会おうって",
      "romaji": "Hibiki Aou tte",
      "en": "\"Hibiki, let's meet up\"",
      "zh": "傳來「響木，見個面吧」的訊息"
    },
    {
      "ja": "連絡きたの",
      "romaji": "Renraku Kita no",
      "en": "She contacted me",
      "zh": "聯絡了我"
    },
    {
      "ja": "アオちゃんが　YouTubeで",
      "romaji": "Ao Chan ga YouTube de",
      "en": "Because Ao-chan had been posting",
      "zh": "因為小葵在YouTube上"
    },
    {
      "ja": "おかしな動画　UPしてるから",
      "romaji": "Okashina Douga UP Shiteru kara",
      "en": "Weird videos on YouTube",
      "zh": "上傳了奇怪的影片"
    },
    {
      "ja": "悪い大人に騙されてないか",
      "romaji": "Warui Otona ni Damasaretenai ka",
      "en": "I was worried she'd been tricked by bad adults",
      "zh": "擔心她是不是被壞大人騙了"
    },
    {
      "ja": "心配で　連絡したの",
      "romaji": "Shinpai de Renraku Shita no",
      "en": "So I reached out out of worry",
      "zh": "因為擔心所以聯絡了"
    },
    {
      "ja": "魔法の鏡号さそったら",
      "romaji": "Mahou no Kagami Gou Sasottara",
      "en": "When I invited the Magic Mirror",
      "zh": "邀請魔法鏡號時"
    },
    {
      "ja": "軽くあしらわれた",
      "romaji": "Karaku Ashirawareta",
      "en": "I got brushed off lightly",
      "zh": "被輕鬆地打發了"
    },
    {
      "ja": "アオちゃんそれより一緒に",
      "romaji": "Ao Chan Sore yori Issho ni",
      "en": "But more than that, Ao-chan, together—",
      "zh": "小葵，與其說那個，不如我們一起"
    },
    {
      "ja": "そら と あお で",
      "romaji": "Sora to Ao de",
      "en": "As Sora and Ao",
      "zh": "以小空和小葵"
    },
    {
      "ja": "走り出したなら",
      "romaji": "Hashiridashita Nara",
      "en": "If we start running",
      "zh": "一旦奔跑起來"
    },
    {
      "ja": "どこまでいけるかな？",
      "romaji": "Doko made Ikeru Kana?",
      "en": "How far can we go?",
      "zh": "能跑到多遠呢？"
    },
    {
      "ja": "青空の風になれ",
      "romaji": "Aozora no Kaze ni Nare",
      "en": "Become the wind of the blue sky",
      "zh": "化身為藍天之風"
    },
    {
      "ja": "厚い雲なんて吹き飛ばせ",
      "romaji": "Atsui Kumo Nante Fukitobase",
      "en": "Blow away even the thick clouds",
      "zh": "把厚厚的雲層也吹散"
    },
    {
      "ja": "ステップで　駆け抜ければ",
      "romaji": "Suteppu de Kakenukereba",
      "en": "If we dash through with steps",
      "zh": "只要踏著步伐奔馳而過"
    },
    {
      "ja": "きらめく青空がステージだ",
      "romaji": "Kirameku Aozora ga Suteeji Da",
      "en": "The sparkling blue sky is our stage",
      "zh": "閃耀的藍天就是舞台"
    },
    {
      "ja": "君もだれかの太陽",
      "romaji": "Kimi mo Dareka no Taiyou",
      "en": "You too are someone's sun",
      "zh": "你也是某個人的太陽"
    },
    {
      "ja": "笑顔がほら　輝いて",
      "romaji": "Egao ga Hora Kagayaite",
      "en": "Look, your smile shines",
      "zh": "你看，笑容閃閃發光"
    },
    {
      "ja": "転んでも　つまづいても",
      "romaji": "Koronde mo Tsumazuite mo",
      "en": "Even if you fall, even if you stumble",
      "zh": "即使跌倒了，即使受挫了"
    },
    {
      "ja": "一歩踏み出したんだ",
      "romaji": "Ippo Fumidashita n Da",
