  "lyrics": [
    {
      "ja": "※ただいま歌詞の翻訳はAIによる生成したものです。人工による翻訳は後ほどアップデートする予定です！",
      "romaji": "",
      "en": "※This translation is currently generated by AI. The refined version is coming soon!",
      "zh": "※此翻譯暫時是AI生成的。人工的翻譯會容後更新！"
    },
    {
      "ja": "せーのっ",
      "romaji": "Seeno",
      "en": "Ready, set",
      "zh": "預備起"
    },
    {
      "ja": "せーので！深呼吸",
      "romaji": "Seeno de! Shinkokyuu",
      "en": "On the count—deep breath!",
      "zh": "預備起！深呼吸"
    },
    {
      "ja": "はじまってく　ここから",
      "romaji": "Hajimatteku Koko kara",
      "en": "It's beginning—from here",
      "zh": "開始了，從這裡"
    },
    {
      "ja": "ready go！",
      "romaji": "Ready Go!",
      "en": "Ready, go!",
      "zh": "ready go！"
    },
    {
      "ja": "大気圏突き抜けて",
      "romaji": "Taikiken Tsukinukete",
      "en": "Piercing through the atmosphere",
      "zh": "穿越大氣層"
    },
    {
      "ja": "イメージも　歌声も",
      "romaji": "Imeeji mo Utagoe mo",
      "en": "Both the image and the singing voice",
      "zh": "無論是想像還是歌聲"
    },
    {
      "ja": "意識を飛び越えて",
      "romaji": "Ishiki wo Tobikoete",
      "en": "Leaping beyond consciousness",
      "zh": "飛越意識"
    },
    {
      "ja": "響く　kira kira",
      "romaji": "Hibiku Kira Kira",
      "en": "Resounding—sparkle, sparkle",
      "zh": "迴響著，kira kira"
    },
    {
      "ja": "電子の小宇宙",
      "romaji": "Denshi no Shou Uchuu",
      "en": "A microscopic electronic universe",
      "zh": "電子的小宇宙"
    },
    {
      "ja": "漂い　めぐり会い",
      "romaji": "Tadayoi Meguri Ai",
      "en": "Drifting, meeting by chance",
      "zh": "漂浮，邂逅"
    },
    {
      "ja": "瞬間　同期する",
      "romaji": "Shunkan Douki Suru",
      "en": "In an instant, synchronizing",
      "zh": "瞬間同步"
    },
    {
      "ja": "キセキって groovy",
      "romaji": "Kiseki tte Groovy",
      "en": "Miracles are groovy",
      "zh": "奇蹟真是 groovy"
    },
    {
      "ja": "BPM　高まって",
      "romaji": "BPM Takamatte",
      "en": "BPM rising",
      "zh": "BPM 高漲"
    },
    {
      "ja": "クルクル回る　みんな",
      "romaji": "Kurukuru Mawaru Minna",
      "en": "Spinning round and round, everyone",
      "zh": "團團轉，大家"
    },
    {
      "ja": "まるでミラーボール",
      "romaji": "Marude Miraa Booru",
      "en": "Just like a mirror ball",
      "zh": "簡直像鏡球一樣"
    },
    {
      "ja": "わたしたちの夢のファーストブレス",
      "romaji": "Watashitachi no Yume no Faasuto Buresu",
      "en": "The first breath of our dream",
      "zh": "我們夢想的第一口氣息"
    },
    {
      "ja": "思い切り　遊ぼう",
      "romaji": "Omoikkiri Asobou",
      "en": "Let's play with all our might",
      "zh": "盡情玩樂吧"
    },
    {
      "ja": "A to Z　空を駆けて",
      "romaji": "A to Z Sora wo Kakete",
      "en": "A to Z, racing through the sky",
      "zh": "A to Z，奔馳天際"
    },
    {
      "ja": "振り切っちゃってこう",
      "romaji": "Furikicchatte Kоу",
      "en": "Let's shake it all off and go",
      "zh": "就全力甩開吧"
    },
    {
      "ja": "化学反応で生み出すヒカリ",
      "romaji": "Kagaku Hannou de Umidasu Hikari",
      "en": "Light created by chemical reactions",
      "zh": "由化學反應產生的光芒"
    },
    {
      "ja": "今ここで　繋がった",
      "romaji": "Ima Koko de Tsunagatta",
      "en": "Right here, now, we connected",
      "zh": "此刻在此，相繫了"
    },
    {
      "ja": "照らして　照らし合って",
      "romaji": "Terashite Terashiatte",
      "en": "Shine, and shine upon each other",
      "zh": "照亮，互相照亮"
    },
    {
      "ja": "せーので！うなずいて",
      "romaji": "Seeno de! Unazuite",
      "en": "On the count—nod!",
      "zh": "預備起！點頭"
    },
    {
      "ja": "はじまってく wonder",
      "romaji": "Hajimatteku Wonder",
      "en": "It's beginning—wonder",
      "zh": "開始了，wonder"
    },
    {
      "ja": "ready go！",
      "romaji": "Ready Go!",
      "en": "Ready, go!",
      "zh": "ready go！"
    },
    {
      "ja": "トキメキ　タップして",
      "romaji": "Tokimeki Tappu Shite",
      "en": "Tap into the excitement",
      "zh": "點擊心動"
    },
    {
      "ja": "ひらくは新時代",
      "romaji": "Hiraku ha Shin Jidai",
      "en": "What opens is a new era",
      "zh": "開啟的是新時代"
    },
    {
      "ja": "可能性　その海は",
      "romaji": "Kanousei Sono Umi ha",
      "en": "Possibility—that sea",
      "zh": "可能性，那片海"
    },
    {
      "ja": "なんて amazing！",
      "romaji": "Nante Amazing!",
      "en": "How amazing!",
      "zh": "多麼 amazing！"
    },
    {
      "ja": "時代のエーテルに",
      "romaji": "Jidai no Eeteru ni",
      "en": "Into the ether of the era",
      "zh": "在時代的以太中"
    },
    {
      "ja": "ドキドキ　伝播する",
      "romaji": "Dokidoki Denpa Suru",
      "en": "Heartbeats propagate",
      "zh": "心跳傳播開來"
    },
    {
      "ja": "解釈一致でしょ？",
      "romaji": "Kaishaku Itchi Desho?",
      "en": "Our interpretations match, right?",
      "zh": "解讀一致對吧？"
    },
    {
      "ja": "生きるって fantastic",
      "romaji": "Ikiru tte Fantastic",
      "en": "Living is fantastic",
      "zh": "活著真是 fantastic"
    },
    {
      "ja": "運命のシンコペーション",
