  "lyrics": [
    {
      "ja": "※ただいま歌詞の翻訳はAIによる生成したものです。人工による翻訳は後ほどアップデートする予定です！",
      "romaji": "",
      "en": "※This translation is currently generated by AI. The refined version is coming soon!",
      "zh": "※此翻譯暫時是AI生成的。人工的翻譯會容後更新！"
    },
    {
      "ja": "暖かい風が",
      "romaji": "Atatakai Kaze ga",
      "en": "A warm wind",
      "zh": "溫暖的風"
    },
    {
      "ja": "頬を優しくなでていく",
      "romaji": "Hoho wo Yasashiku Nadete Iku",
      "en": "Gently strokes my cheek",
      "zh": "輕輕拂過臉頰"
    },
    {
      "ja": "深呼吸を1つ",
      "romaji": "Shinkokyuu wo Hitotsu",
      "en": "I take one deep breath",
      "zh": "做一次深呼吸"
    },
    {
      "ja": "心を落ち着けてみる",
      "romaji": "Kokoro wo Ochitsukete Miru",
      "en": "And try to calm my heart",
      "zh": "試著讓心平靜下來"
    },
    {
      "ja": "独りぼっちじゃない",
      "romaji": "Hitoribocchi ja Nai",
      "en": "I'm not alone",
      "zh": "我並不孤單"
    },
    {
      "ja": "姿は見えないけれど",
      "romaji": "Sugata ha Mienai Keredo",
      "en": "Even though I can't see your figures",
      "zh": "雖然看不見你們的身影"
    },
    {
      "ja": "みんなここにいるよ",
      "romaji": "Minna Koko ni Iru yo",
      "en": "Everyone is right here",
      "zh": "但大家都在這裡"
    },
    {
      "ja": "来てくれてありがとう",
      "romaji": "Kite Kurete Arigatou",
      "en": "Thank you for coming",
      "zh": "謝謝你們前來"
    },
    {
      "ja": "ガラス越しのセカイ",
      "romaji": "Garasu Goshi no Sekai",
      "en": "A world beyond the glass",
      "zh": "隔著玻璃的世界"
    },
    {
      "ja": "絵空事を信じてるよ",
      "romaji": "Esoragoto wo Shinjiteru yo",
      "en": "I believe in that fanciful dream",
      "zh": "我相信著那如夢似幻的事"
    },
    {
      "ja": "同じ空の下て",
      "romaji": "Onaji Sora no Shita de",
      "en": "Under the same sky",
      "zh": "在同一片天空下"
    },
    {
      "ja": "同じ時を過ごしてるよ",
      "romaji": "Onaji Toki wo Sugoshiteru yo",
      "en": "We're spending the same time together",
      "zh": "我們共度著相同的時光"
    },
    {
      "ja": "私の声 聞こえてますか",
      "romaji": "Watashi no Koe Kikoete Masu ka",
      "en": "Can you hear my voice?",
      "zh": "我的聲音，你聽得見嗎"
    },
    {
      "ja": "私の姿 見えていますか",
      "romaji": "Watashi no Sugata Miete Imasu ka",
      "en": "Can you see my figure?",
      "zh": "我的身影，你看得見嗎"
    },
    {
      "ja": "みんなふぁくれる言葉で",
      "romaji": "Minna fa Kureru Kotoba de",
      "en": "With the words everyone gives me",
      "zh": "因為大家給予的話語"
    },
    {
      "ja": "今日も青空が晴れわたる",
      "romaji": "Kyou mo Aozora ga Hrewataru",
      "en": "The blue sky clears up again today",
      "zh": "今天的藍天也晴朗無雲"
    },
    {
      "ja": "私の歌 届いてますか",
      "romaji": "Watashi no Uta Todoite Masu ka",
      "en": "Is my song reaching you?",
      "zh": "我的歌聲，傳達到了嗎"
    },
    {
      "ja": "私の思い 伝わってますか",
      "romaji": "Watashi no Omoi Tsutawatte Masu ka",
      "en": "Are my feelings getting through?",
      "zh": "我的思念，傳達到了嗎"
    },
    {
      "ja": "みんながくれる言葉で",
