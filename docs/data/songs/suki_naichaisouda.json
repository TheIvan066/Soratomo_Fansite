  "lyrics": [
    {
      "ja": "※ただいま歌詞の翻訳はAIによる生成したものです。人工による翻訳は後ほどアップデートする予定です！",
      "romaji": "",
      "en": "※This translation is currently generated by AI. The refined version is ",
      "zh": "※此翻譯暫時是AI生成的。人工的翻譯會容後更新！"
    },
    {
      "ja": "イジワルな言葉を",
      "romaji": "Ijiwaru na Kotoba wo",
      "en": "Saying mean-spirited words",
      "zh": "故意說出"
    },
    {
      "ja": "わざと言ったりして",
      "romaji": "Waza to Ittari Shite",
      "en": "On purpose",
      "zh": "那些壞心眼的話"
    },
    {
      "ja": "欲張りなくらい",
      "romaji": "Yokubari na Kurai",
      "en": "Almost greedily",
      "zh": "貪心地"
    },
    {
      "ja": "キミを知りたいよ",
      "romaji": "Kimi wo Shiritai yo",
      "en": "I want to know you",
      "zh": "好想了解你"
    },
    {
      "ja": "恥ずかしがらないでおいで",
      "romaji": "Hazukashigaranaide Oide",
      "en": "Don't be shy, come here",
      "zh": "別害羞，過來吧"
    },
    {
      "ja": "出会えた偶然を",
      "romaji": "Deaeta Guuzen wo",
      "en": "This chance encounter",
      "zh": "想把相遇的偶然"
    },
    {
      "ja": "運命に変えたいな",
      "romaji": "Unmei ni Kaetai na",
      "en": "I want to turn it into fate",
      "zh": "變成命運"
    },
    {
      "ja": "始まった恋は加速していくの",
      "romaji": "Hajimatta Koi ha Kasoku Shite Iku no",
      "en": "This love that started is accelerating",
      "zh": "開始的戀情正不斷加速"
    },
    {
      "ja": "ブレーキはかけられないの",
      "romaji": "Bureeki ha Kakerarenai no",
      "en": "I can't put on the brakes",
      "zh": "無法踩下煞車"
    },
    {
      "ja": "未完成なパズル",
      "romaji": "Mikansei na Pazuru",
      "en": "An incomplete puzzle",
      "zh": "未完成的拼圖"
    },
    {
      "ja": "恋というピースを",
      "romaji": "Koi to Iu Piisu wo",
      "en": "The piece called love",
      "zh": "將名為戀愛的拼片"
    },
    {
      "ja": "重ね合わせよう",
      "romaji": "Kasane Awaseru yo",
      "en": "Let's fit them together",
      "zh": "拼合在一起吧"
    },
    {
      "ja": "心はキミで埋まっていく",
      "romaji": "Kokoro ha Kimi de Umatte Iku",
      "en": "My heart is being filled with you",
      "zh": "心裡逐漸被你填滿"
    },
    {
      "ja": "いつだって",
      "romaji": "Itsu Datte",
      "en": "Always",
      "zh": "無論何時"
    },
    {
      "ja": "そのままのキミが好き",
      "romaji": "Sono Mama no Kimi ga Suki",
      "en": "I love you just the way you are",
      "zh": "我喜歡原本的你"
    },
    {
      "ja": "不器用で人見知り",
      "romaji": "Bukiyou de Hitomishiri",
      "en": "Clumsy and shy around strangers",
      "zh": "笨拙又怕生"
    },
    {
      "ja": "無口だけど誰より優しい人ね",
      "romaji": "Mukuchi Dakedo Dare yori Yasashii Hito ne",
      "en": "Quiet, but kinder than anyone",
      "zh": "沉默寡言，卻比誰都溫柔的人呢"
    },
    {
      "ja": "少し猫背なとこも",
      "romaji": "Sukoshi Nekoze na Toko mo",
      "en": "Even your slightly hunched back",
      "zh": "有點駝背的地方也好"
    },
    {
      "ja": "優柔不断なとこも",
      "romaji": "Yuujuu Fudan na Toko mo",
      "en": "Even your indecisiveness",
      "zh": "優柔寡斷的地方也好"
    },
    {
      "ja": "強がるけど泣き虫なとこも　全部",
      "romaji": "Tsuyogaru kedo Nakimushi na Toko mo Zenbu",
      "en": "Even your tough act and crybaby side—all of it",
      "zh": "逞強卻愛哭的地方也好，全部"
    },
    {
      "ja": "好き、泣いちゃうくらい",
      "romaji": "Suki, Naichau Kurai",
      "en": "I love you, so much I could cry",
      "zh": "喜歡你，喜歡到快哭出來"
    },
    {
      "ja": "まるでこの世界に",
      "romaji": "Maru de Kono Sekai ni",
      "en": "As if in this world",
      "zh": "彷彿這個世界上"
    },
    {
      "ja": "たった二人きりみたい",
      "romaji": "Tatta Futari Kiri Mitai",
      "en": "There are only the two of us",
      "zh": "只剩下我們兩個人"
    },
    {
      "ja": "伸びた二つの影が",
      "romaji": "Nobita Futatsu no Kage ga",
      "en": "Our two stretching shadows",
      "zh": "兩道拉長的影子"
    },
    {
      "ja": "寄り添う帰り道は",
      "romaji": "Yorisou Kaerimichi ha",
      "en": "On the way home, drawing close together",
      "zh": "在回家路上相互依偎"
    },
    {
      "ja": "なんだか少し切なくて",
      "romaji": "Nandaka Sukoshi Setsunakute",
      "en": "Somehow it's a little bittersweet",
      "zh": "總覺得有些傷感"
    },
    {
      "ja": "風になびく髪が",
      "romaji": "Kaze ni Nabiku Kami ga",
      "en": "My hair fluttering in the wind",
      "zh": "隨風飄動的頭髮"
    },
    {
      "ja": "キミを追いかける",
      "romaji": "Kimi wo Oikakeru",
      "en": "Chases after you",
      "zh": "追趕著你"
    },
    {
      "ja": "あと数センチの",
      "romaji": "Ato Suu Senchi no",
      "en": "Just a few more centimeters",
      "zh": "僅剩幾公分的"
    },
    {
      "ja": "距離が胸を締め付けるの",
      "romaji": "Kyori ga Mune wo Shimetsukeru no",
      "en": "This distance squeezes my chest",
      "zh": "距離緊揪著胸口"
    },
    {
      "ja": "いつだって",
      "romaji": "Itsu Datte",
      "en": "Always",
      "zh": "無論何時"
    },
    {
      "ja": "届きそうで届かない",
      "romaji": "Todokisou de Todokanai",
      "en": "Seems within reach, yet out of reach",
      "zh": "看似觸手可及，卻又觸碰不到"
    },
    {
      "ja": "触れそうで触れられない",
      "romaji": "Furesou de Furerarenai",
      "en": "Seems touchable, yet can't be touched",
      "zh": "看似能碰觸，卻又碰不到"
    },
    {
      "ja": "近そうで遠いキミのその指先",
      "romaji": "Chikasou de Tooi Kimi no Sono Yubisaki",
      "en": "Seemingly close, yet distant—your fingertips",
      "zh": "看似靠近卻遙遠，你的指尖"
    },
    {
      "ja": "溢れ出すこの思い",
      "romaji": "Afuredasu Kono Omoi",
      "en": "These overflowing feelings",
      "zh": "滿溢而出的這份思念"
    },
    {
      "ja": "今キミに伝えたら",
      "romaji": "Ima Kimi ni Tsutaetara",
      "en": "If I tell you now",
      "zh": "如果現在告訴你"
    },
    {
      "ja": "この手をぎゅっと強く",
      "romaji": "Kono Te wo Gyutto Tsuyoku",
      "en": "Would you tightly and firmly",
      "zh": "你能緊緊地"
    },
    {
      "ja": "握ってくれませんか？",
      "romaji": "Nigitte Kuremasen ka?",
      "en": "Hold my hand?",
      "zh": "握住我的手嗎？"
    },
    {
      "ja": "初めて出会った瞬間に",
      "romaji": "Hajimete Deatta Shunkan ni",
      "en": "At the moment we first met",
      "zh": "在初次相遇的瞬間"
    },
    {
      "ja": "胸が熱くなって",
      "romaji": "Mune ga Atsuku Natte",
      "en": "My chest grew hot",
      "zh": "胸口變得熾熱"
    },
    {
      "ja": "きっとあの日から",
      "romaji": "Kitto Ano Hi kara",
      "en": "Surely since that day",
      "zh": "一定從那天起"
    },
    {
      "ja": "キミのことを、、、",
      "romaji": "Kimi no Koto wo...",
      "en": "I've been... thinking about you",
      "zh": "就一直對你……"
    },
    {
      "ja": "まだ一緒にいたくて",
      "romaji": "Mada Issho ni Itakute",
      "en": "I still want to be together",
      "zh": "還想和你在一起"
    },
    {
      "ja": "ずっと側にいたくて",
      "romaji": "Zutto Soba ni Itakute",
      "en": "I want to stay by your side forever",
      "zh": "想永遠待在你身邊"
    },
    {
      "ja": "キミも同じ気持ちでいてくれるかな",
      "romaji": "Kimi mo Onaji Kimochi de Ite Kureru Kana",
