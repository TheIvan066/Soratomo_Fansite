  "lyrics": [
    {
      "ja": "ゆれる街灯 篠突く雨",
      "romaji": "Yureru gaitou shinotsuku ame",
      "en": "Swaying streetlights, a driving rain,",
      "zh": "搖曳的路燈，滂沱大雨，",
      "notes": [
        {
          "word": "篠突く雨",
          "meaning": "driving rain"
        }
      ]
    },
    {
      "ja": "傘もささずに 立ち尽くす",
      "romaji": "Kasa mo sasazu ni tachitsukusu",
      "en": "I stand still without an umbrella.",
      "zh": "我撐著傘，佇立原地。"
    },
    {
      "ja": "君の言葉が 胸に響く",
      "romaji": "Kimi no kotoba ga mune ni hibiku",
      "en": "Your words echo in my heart,",
      "zh": "你的話語，迴盪在我心中，",
      "notes": [
        {
          "word": "響く",
          "meaning": "echo"
        }
      ]
    },
    {
      "ja": "忘れられない あの日のこと",
      "romaji": "Wasurerarenai ano hi no koto",
      "en": "I can't forget that day.",
      "zh": "那一天，我無法忘懷。"
    },
    {
      "ja": "ブルーベリームーン 夜空に浮かぶ",
      "romaji": "Blueberry Moon Yozora ni ukabu",
      "en": "Blueberry Moon, floating in the night sky,",
      "zh": "藍莓月亮，浮現夜空，"
    },
    {
      "ja": "淡い光が 僕らを照らす",
      "romaji": "Awai hikari ga bokura wo terasu",
      "en": "Its faint light illuminates us.",
      "zh": "微弱的光芒，照耀著我們。",
      "notes": [
        {
          "word": "淡い",
          "meaning": "faint"
        }
      ]
    },
    {
      "ja": "冷たい風が 頬を撫でる",
      "romaji": "Tsumetai kaze ga hoo wo naderu",
      "en": "A cold wind brushes my cheek,",
      "zh": "冰冷的風，輕撫我的臉頰，",
      "notes": [
        {
          "word": "撫でる",
          "meaning": "brush"
        }
      ]
    },
    {
      "ja": "君の温もり 思い出す",
      "romaji": "Kimi no nukumori omoidasu",
      "en": "I remember your warmth.",
      "zh": "我想起了你的溫暖。"
    },
    {
      "ja": "遠い記憶が 蘇る",
      "romaji": "Tooi kioku ga yomigaeru",
      "en": "Distant memories revive,",
      "zh": "遙遠的記憶，再次浮現，",
      "notes": [
        {
          "word": "蘇る",
          "meaning": "revive"
        }
      ]
    },
    {
      "ja": "もう一度だけ 会いたいな",
      "romaji": "Mou ichido dake aitai na",
      "en": "I wish to see you just one more time.",
      "zh": "我多麼想再見你一面。"
    },
    {
      "ja": "ブルーベリームーン 夜空に浮かぶ",
      "romaji": "Blueberry Moon Yozora ni ukabu",
      "en": "Blueberry Moon, floating in the night sky,",
      "zh": "藍莓月亮，浮現夜空，"
    },
    {
      "ja": "淡い光が 僕らを照らす",
      "romaji": "Awai hikari ga bokura wo terasu",
      "en": "Its faint light illuminates us.",
      "zh": "微弱的光芒，照耀著我們。"
    },
    {
      "ja": "時が流れても 変わらない",
      "romaji": "Toki ga nagarete mo kawaranai",
      "en": "Even if time flows on, these feelings won't change,",
      "zh": "即使時光流逝，這份思念也不會改變，"
    },
    {
      "ja": "この想いは 永遠に",
      "romaji": "Kono omoi wa eien ni",
      "en": "They are eternal.",
      "zh": "它將永遠存在。",
      "notes": [
