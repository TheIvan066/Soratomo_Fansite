  "calls": [],
  "lyrics": [
    {
      "ja": "ゆれる街灯 篠突く雨",
      "romaji": "Yureru gaitou shinotsuku ame",
      "en": "Swaying streetlights, a driving rain,",
      "zh": "搖曳的路燈，傾盆大雨，",
      "notes": [
        {
          "word": "街灯",
          "meaning": "streetlight"
        }
      ]
    },
    {
      "ja": "傘もささずに立ち尽くす",
      "romaji": "Kasa mo sasazu ni tachitsukusu",
      "en": "I stand drenched, without an umbrella.",
      "zh": "我撐著傘，佇立不語。",
      "notes": [
        {
          "word": "傘",
          "meaning": "umbrella"
        }
      ]
    },
    {
      "ja": "君がくれた合鍵は",
      "romaji": "Kimi ga kureta aikagi wa",
      "en": "The spare key you gave me",
      "zh": "你給我的備用鑰匙",
      "notes": [
        {
          "word": "合鍵",
          "meaning": "spare key"
        }
      ]
    },
    {
      "ja": "錆びて開かないまま",
      "romaji": "Sabite hirakanai mama",
      "en": "Remains rusted, unable to open.",
      "zh": "已經生鏽，無法打開。",
      "notes": [
        {
          "word": "錆びて",
          "meaning": "rusted"
        }
      ]
    },
    {
      "ja": "思い出のレコードは",
      "romaji": "Omoide no rekoodo wa",
      "en": "The record of our memories,",
      "zh": "承載回憶的唱片，",
      "notes": [
        {
          "word": "レコード",
          "meaning": "record"
        }
      ]
    },
    {
      "ja": "針を落とせばノイズだらけ",
      "romaji": "Hari wo otoseba noizu darake",
      "en": "When the needle drops, it's full of noise.",
      "zh": "唱針落下，卻滿是雜音。",
      "notes": [
        {
          "word": "ノイズ",
          "meaning": "noise"
        }
      ]
    },
    {
      "ja": "それでも聴きたいんだ",
      "romaji": "Soredemo kikitai n'da",
      "en": "Yet, I still want to hear it,",
      "zh": "儘管如此，我還是想聽，",
      "notes": [
        {
          "word": "聴きたい",
          "meaning": "want to hear"
        }
      ]
    },
    {
      "ja": "あの日のメロディー",
      "romaji": "Ano hi no merodii",
      "en": "That melody from that day.",
      "zh": "那天的旋律。",
      "notes": [
        {
          "word": "メロディー",
          "meaning": "melody"
        }
      ]
    },
    {
      "ja": "未練レコード くるくる回る",
      "romaji": "Miren rekoodo kurukuru mawaru",
      "en": "The lingering record spins round and round,",
      "zh": "留戀的唱片，不停地旋轉，",
      "notes": [
        {
          "word": "未練",
          "meaning": "lingering attachment"
        }
      ]
    },
    {
      "ja": "君の声が聴こえる気がした",
      "romaji": "Kimi no koe ga kikoeru ki ga shita",
      "en": "I felt as if I could hear your voice.",
      "zh": "我感覺好像聽見了你的聲音。",
      "notes": [
        {
          "word": "声",
          "meaning": "voice"
        }
      ]
    },
    {
      "ja": "もう一度だけ 抱きしめてよ",
      "romaji": "Mou ichido dake dakishimete yo",
      "en": "Just one more time, hold me close,",
      "zh": "只要再抱我一次就好，",
      "notes": [
        {
          "word": "抱きしめて",
          "meaning": "hold me"
        }
      ]
    },
    {
      "ja": "叶わない願いだと知ってても",
      "romaji": "Kanawanai negai da to shittete mo",
      "en": "Even though I know it's an impossible wish.",
      "zh": "即使知道這是無法實現的願望。",
      "notes": [
        {
          "word": "願い",
          "meaning": "wish"
        }
      ]
    },
    {
      "ja": "冷たい風 頬を撫でる",
      "romaji": "Tsumetai kaze hoho wo naderu",
      "en": "A cold wind brushes my cheek,",
      "zh": "冰冷的風輕撫臉頰，",
      "notes": [
        {
          "word": "冷たい",
          "meaning": "cold"
        }
      ]
    },
    {
      "ja": "君の温もり探してる",
      "romaji": "Kimi no nukumori sagashiteru",
      "en": "I'm searching for your warmth.",
      "zh": "我尋找著你的溫暖。",
      "notes": [
        {
          "word": "温もり",
          "meaning": "warmth"
        }
      ]
    },
    {
      "ja": "ポケットの中 握りしめた",
      "romaji": "Poketto no naka nigirishimeta",
      "en": "Clutched tightly in my pocket,",
      "zh": "緊握在口袋裡的是",
      "notes": [
        {
          "word": "ポケット",
          "meaning": "pocket"
        }
      ]
    },
    {
      "ja": "色褪せた写真",
      "romaji": "Iroaseta shashin",
      "en": "Is a faded photograph.",
      "zh": "一張褪色的照片。",
      "notes": [
        {
          "word": "写真",
          "meaning": "photograph"
        }
      ]
    },
    {
      "ja": "時が止まればいいのに",
      "romaji": "Toki ga tomareba ii noni",
      "en": "I wish time would just stop,",
      "zh": "時間要是"
    }
  ]
}
