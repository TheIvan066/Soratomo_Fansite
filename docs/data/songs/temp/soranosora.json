  "lyrics": [
    {
      "ja": "ゆれる街灯 篠突く雨",
      "romaji": "Yureru gaitou shinotsuku ame",
      "en": "Swaying streetlights, pouring rain",
      "zh": "搖曳的街燈，滂沱大雨",
      "notes": [
        {
          "word": "篠突く",
          "meaning": "pouring heavily"
        }
      ]
    },
    {
      "ja": "傘も差さずに 立ち尽くす",
      "romaji": "Kasa mo sasazu ni tachitsukusu",
      "en": "Standing still without an umbrella",
      "zh": "不撐傘，佇立原地",
      "notes": [
        {
          "word": "立ち尽くす",
          "meaning": "stand still"
        }
      ]
    },
    {
      "ja": "君の横顔 濡れた髪",
      "romaji": "Kimi no yokogao nureta kami",
      "en": "Your profile, with wet hair",
      "zh": "你的側臉，濕潤的髮絲",
      "notes": [
        {
          "word": "横顔",
          "meaning": "profile"
        }
      ]
    },
    {
      "ja": "何も言えずに 見つめてた",
      "romaji": "Nani mo iezu ni mitsumeteta",
      "en": "I just gazed, unable to say anything",
      "zh": "什麼也沒說，只是凝視著",
      "notes": [
        {
          "word": "見つめてた",
          "meaning": "gazed"
        }
      ]
    },
    {
      "ja": "あの日からずっと",
      "romaji": "Ano hi kara zutto",
      "en": "Ever since that day",
      "zh": "從那天起，一直",
      "notes": [
        {
          "word": "ずっと",
          "meaning": "always"
        }
      ]
    },
    {
      "ja": "僕の心は",
      "romaji": "Boku no kokoro wa",
      "en": "My heart",
      "zh": "我的心",
      "notes": [
        {
          "word": "心",
          "meaning": "heart"
        }
      ]
    },
    {
      "ja": "君の隣で",
      "romaji": "Kimi no tonari de",
      "en": "Next to you",
      "zh": "在你的身旁",
      "notes": [
        {
          "word": "隣",
          "meaning": "next to"
        }
      ]
    },
    {
      "ja": "止まったまま",
      "romaji": "Tomatta mama",
      "en": "Remained stopped",
      "zh": "就此停滯不前",
      "notes": [
        {
          "word": "止まったまま",
          "meaning": "remained stopped"
        }
      ]
    },
    {
      "ja": "空ノ空 どこまでも",
      "romaji": "Sora no Sora doko made mo",
      "en": "Sky of skies, endlessly",
      "zh": "天空之空，無論何處",
      "notes": [
        {
          "word": "空ノ空",
          "meaning": "sky of skies"
        }
      ]
    },
    {
      "ja": "続く青い世界",
      "romaji": "Tsuzuku aoi sekai",
      "en": "The blue world continues",
      "zh": "延續的藍色世界",
      "notes": [
        {
          "word": "世界",
          "meaning": "world"
        }
      ]
    },
    {
      "ja": "君と僕を繋ぐ",
      "romaji": "Kimi to boku wo tsunagu",
      "en": "Connecting you and me",
      "zh": "連結你我",
      "notes": [
        {
          "word": null
        }
      ]
    }
