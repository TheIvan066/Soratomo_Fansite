      "zh": "(純音樂)"
    },
    {
      "ja": "光の波に乗って どこまでも行こう",
      "romaji": "Hikari no nami ni notte doko made mo ikou",
      "en": "Riding on waves of light, let's go anywhere",
      "zh": "乘著光的波浪 無論何處都去吧",
      "notes": [
        {
          "word": "波",
          "meaning": "wave"
        }
      ]
    },
    {
      "ja": "夢の先へ 駆け出すの",
      "romaji": "Yume no saki e kakedasu no",
      "en": "Rushing forth to the future of our dreams",
      "zh": "朝著夢想的彼方 奔馳而去",
      "notes": [
        {
          "word": "夢",
          "meaning": "dream"
        }
      ]
    },
    {
      "ja": "キラキラ輝く世界 止まらない鼓動",
      "romaji": "Kirakira kagayaku sekai tomaranai kodou",
      "en": "A sparkling, shining world, an unstoppable heartbeat",
      "zh": "閃耀光輝的世界 永不停歇的鼓動",
      "notes": [
        {
          "word": "鼓動",
          "meaning": "heartbeat"
        }
      ]
    },
    {
      "ja": "新しい自分 見つけたい",
      "romaji": "Atarashii jibun mitsuketai",
      "en": "I want to find a new me",
      "zh": "想找到全新的自己",
      "notes": [
        {
          "word": "自分",
          "meaning": "self"
        }
      ]
    },
    {
      "ja": "不安な気持ちも 飛ばして",
      "romaji": "Fuan na kimochi mo tobashite",
      "en": "Let's cast away anxious feelings",
      "zh": "將不安的心情 也一併拋開",
      "notes": [
        {
          "word": "不安",
          "meaning": "anxiety"
        }
      ]
    },
    {
      "ja": "大空へ 舞い上がれ",
      "romaji": "Oozora e maiagare",
      "en": "Soar up into the vast sky",
      "zh": "飛舞升上廣闊的天空",
      "notes": [
        {
          "word": "大空",
          "meaning": "sky"
        }
      ]
    },
    {
      "ja": "エレクトリカル・サーフィン！心が踊る",
      "romaji": "Erekutorikaru Saafin! Kokoro ga odoru",
      "en": "Electrical Surfing! My heart dances",
      "zh": "電子衝浪！我的心在跳舞",
      "notes": [
        {
          "word": "心",
          "meaning": "heart"
        }
      ]
    },
    {
      "ja": "この瞬間 永遠に続け",
      "romaji": "Kono shunkan eien ni tsuzuke",
      "en": "May this moment last forever",
      "zh": "願這瞬間 永遠持續",
      "notes": [
        {
          "word": "永遠",
          "meaning": "eternity"
        }
      ]
    },
    {
      "ja": "エレクトリカル・サーフィン！みんなと一緒",
      "romaji": "Erekutorikaru Saafin! Minna to issho ni",
      "en": "Electrical Surfing! Together with everyone",
      "zh": "電子衝浪！和大家一起",
      "notes": [
        {
          "word": "みんな",
          "meaning": "everyone"
        }
      ]
    },
    {
      "ja": "未来へ向かって 突き進むよ",
      "romaji": "Mirai e mukatte tsukisusumu yo",
      "en": "We'll push forward towards the future",
      "zh": "朝著未來"
    }
  ]
