  "lyrics": [
    {
      "ja": "雨の日は なんだか部屋の中の",
      "romaji": "Ame no hi wa nandaka heya no naka no",
      "en": "On rainy days, somehow, the time",
      "zh": "下雨天時，不知為何，房間裡的時間",
      "notes": [
        {
          "word": "雨の日",
          "meaning": "rainy day"
        }
      ]
    },
    {
      "ja": "時間が止まる気がする",
      "romaji": "Jikan ga tomaru ki ga suru",
      "en": "feels like it stops.",
      "zh": "感覺停滯了。",
      "notes": [
        {
          "word": "止まる",
          "meaning": "stops"
        }
      ]
    },
    {
      "ja": "温かいスープを飲みながら",
      "romaji": "Atatakai suupu o nominagara",
      "en": "While sipping warm soup,",
      "zh": "一邊喝著溫暖的湯，",
      "notes": [
        {
          "word": "温かい",
          "meaning": "warm"
        }
      ]
    },
    {
      "ja": "落ちる雫を見ている",
      "romaji": "Ochiru shizuku o miteiru",
      "en": "I watch the falling drops.",
      "zh": "一邊看著落下的水滴。",
      "notes": [
        {
          "word": "雫",
          "meaning": "drops"
        }
      ]
    },
    {
      "ja": "夏休みの予定が",
      "romaji": "Natsuyasumi no yotei ga",
      "en": "My summer vacation plans",
      "zh": "暑假計畫",
      "notes": [
        {
          "word": "夏休み",
          "meaning": "summer vacation"
        }
      ]
    },
    {
      "ja": "大混乱ですよ",
      "romaji": "Daikonran desu yo",
      "en": "are in utter chaos.",
      "zh": "真是大混亂啊。",
      "notes": [
        {
          "word": "大混乱",
          "meaning": "chaos"
        }
      ]
    },
    {
      "ja": "雨のち雨模様で1週間は",
      "romaji": "Ame nochi ame moyou de isshuukan wa",
      "en": "With a forecast of rain, then more rain, for a whole week,",
      "zh": "一週都是雨後又雨的天氣，",
      "notes": [
        {
          "word": "雨模様",
          "meaning": "rainy weather"
        }
      ]
    },
    {
      "ja": "家の中らしい",
      "romaji": "Ie no naka rashii",
      "en": "it seems I'll be stuck inside.",
      "zh": "看來只能待在家裡了。",
      "notes": [
        {
          "word": "家の中",
          "meaning": "inside home"
        }
      ]
    },
    {
      "ja": "てるてる坊主じゃ",
      "romaji": "Teruteru bouzu ja",
      "en": "A teru teru bozu alone",
      "zh": "光是晴天娃娃",
      "notes": [
        {
          "word": "てるてる坊主",
          "meaning": "teru teru bozu"
        }
      ]
    },
    {
      "ja": "やまない雨は",
      "romaji": "Yamanai ame wa",
      "en": "cannot stop this rain.",
      "zh": "止不住的雨，",
      "notes": [
        {
          "word": "やまない",
          "meaning": "won't stop"
        }
      ]
    },
    {
      "ja": "その雨雲を私に重ねてる",
      "romaji": "Sono amagumo o watashi ni kasaneteru",
      "en": "Those rain clouds overlap with me.",
      "zh": "那片雨雲與我重疊。",
      "notes": [
        {
          "word": "雨雲",
          "meaning": "rain clouds"
        }
      ]
    }
  ]
}
