  "lyrics": [
    {
      "ja": "ねぇ、ちょっと聞いてくれるかな",
      "romaji": "Nee, chotto kiite kureru kana",
      "en": "Hey, could you listen for a bit?",
      "zh": "嘿，能聽我說一下嗎？",
      "notes": [
        {
          "word": "聞いて",
          "meaning": "listen"
        }
      ]
    },
    {
      "ja": "最近なんだか元気ないの",
      "romaji": "Saikin nandaka genki nai no",
      "en": "Lately, I've been feeling a bit down.",
      "zh": "最近總覺得沒什麼精神",
      "notes": [
        {
          "word": "元気ない",
          "meaning": "not energetic"
        }
      ]
    },
    {
      "ja": "ため息ばかりついてる私に",
      "romaji": "Tameiki bakari tsuiteru watashi ni",
      "en": "To me, who's always sighing,",
      "zh": "對總是嘆氣的我",
      "notes": [
        {
          "word": "ため息",
          "meaning": "sigh"
        }
      ]
    },
    {
      "ja": "喝を入れてよ",
      "romaji": "Katsu o irete yo",
      "en": "Give me a cheer!",
      "zh": "給我打打氣吧",
      "notes": [
        {
          "word": "喝",
          "meaning": "cheer"
        }
      ]
    },
    {
      "ja": "頑張ってるのは知ってるけど",
      "romaji": "Ganbatteru no wa shitteru kedo",
      "en": "I know you're doing your best, but",
      "zh": "我知道你很努力",
      "notes": [
        {
          "word": "頑張ってる",
          "meaning": "doing best"
        }
      ]
    },
    {
      "ja": "たまには休んだっていいんだよ",
      "romaji": "Tama ni wa yasundatte ii n da yo",
      "en": "It's okay to rest sometimes.",
      "zh": "偶爾休息一下也沒關係喔",
      "notes": [
        {
          "word": "休んだって",
          "meaning": "rest"
        }
      ]
    },
    {
      "ja": "でもね、やっぱり悔しいから",
      "romaji": "Demo ne, yappari kuyashii kara",
      "en": "But still, I'm frustrated, so",
      "zh": "但是呢，果然還是不甘心",
      "notes": [
        {
          "word": "悔しい",
          "meaning": "frustrated"
        }
      ]
    },
    {
      "ja": "もう一度だけ",
      "romaji": "Mou ichido dake",
      "en": "Just one more time.",
      "zh": "就再一次",
      "notes": [
        {
          "word": "もう一度",
          "meaning": "one more time"
        }
      ]
    },
    {
      "ja": "フレーフレーLOVE 届けたいエール",
      "romaji": "Furee Furee LOVE todoketai eeru",
      "en": "Hooray Hooray LOVE, I want to send my cheers",
      "zh": "加油加油LOVE，想傳達我的聲援",
      "notes": [
        {
          "word": "エール",
          "meaning": "cheers"
        }
      ]
    },
    {
      "ja": "君の笑顔が見たいから",
      "romaji": "Kimi no egao ga mitai kara",
      "en": "Because I want to see your smile.",
      "zh": "因為我想看見你的笑容",
      "notes": [
        {
          "word": "笑顔",
          "meaning": "smile"
        }
      ]
    },
    {
      "ja": "フレーフレーLOVE 負けないでね",
      "romaji": "Furee Furee LOVE makenaide ne",
      "en": "Hooray Hooray LOVE, don't give up!",
      "zh": "加油加油LOVE，不要輸喔",
      "notes": [
        {
          "word": "負けないで",
          "meaning": "don't give up"
        }
      ]
    },
    {
      "ja": "きっと夢は叶うから",
      "romaji": "Kitto yume wa kanau kara",
      "en": "Your dreams will surely come true.",
      "zh": "夢想一定會實現的",
      "notes": [
        {
          "word": "叶う",
          "meaning": "come true"
        }
      ]
    },
    {
      "ja": "ねぇ、ちょっと笑ってくれるかな",
      "romaji": "Nee, chotto waratte kureru kana",
      "en": null
    }
  ]
}
