  "calls": [],
  "lyrics": [
    {
      "ja": "見慣れた景色に背を向けて",
      "romaji": "Minareta keshiki ni se wo mukete",
      "en": "Turning my back on the familiar scenery,",
      "zh": "背對著熟悉的景色，"
    },
    {
      "ja": "踏み出した一歩は",
      "romaji": "Fumidashita ippo wa",
      "en": "The first step I took",
      "zh": "邁出的第一步，"
    },
    {
      "ja": "少しだけ震えてた",
      "romaji": "Sukoshi dake furueteta",
      "en": "Trembled just a little.",
      "zh": "有些許顫抖。"
    },
    {
      "ja": "でもね、大丈夫",
      "romaji": "Demo ne, daijoubu",
      "en": "But it's okay, you know.",
      "zh": "但是呢，沒關係的。"
    },
    {
      "ja": "君がくれた言葉が",
      "romaji": "Kimi ga kureta kotoba ga",
      "en": "Because the words you gave me",
      "zh": "因為你給我的話語，"
    },
    {
      "ja": "背中を押してくれたから",
      "romaji": "Senaka wo oshite kureta kara",
      "en": "Pushed me forward,",
      "zh": "推動了我的背脊，"
    },
    {
      "ja": "もう迷わない",
      "romaji": "Mou mayowanai",
      "en": "I won't hesitate anymore.",
      "zh": "我不再迷茫。"
    },
    {
      "ja": "そらを超えて どこまでも行こう",
      "romaji": "Sora wo koete doko made mo ikou",
      "en": "Beyond the sky, let's go anywhere,",
      "zh": "超越天空，無論去哪裡都行，"
    },
    {
      "ja": "光の先へ 夢を追いかけて",
      "romaji": "Hikari no saki e yume wo oikakete",
      "en": "Towards the light, chasing our dreams.",
      "zh": "追逐著夢想，前往光芒的彼方。"
    },
    {
      "ja": "どんな壁も 乗り越えてみせるよ",
      "romaji": "Donna kabe mo norikoete miseru yo",
      "en": "I'll overcome any wall,",
      "zh": "無論什麼樣的阻礙，我都會跨越給你看，"
    },
    {
      "ja": "君と一緒なら きっと",
      "romaji": "Kimi to issho nara kitto",
      "en": "If I'm with you, I'm sure.",
      "zh": "只要和你在一起，一定能做到。"
    },
    {
      "ja": "新しい出会いと",
      "romaji": "Atarashii deai to",
      "en": "New encounters",
      "zh": "新的相遇，"
    },
    {
      "ja": "別れを繰り返して",
      "romaji": ""
    }
  ]
}
