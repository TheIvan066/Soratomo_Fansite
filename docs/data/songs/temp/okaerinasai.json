  "lyrics": [
    {
      "ja": "(Instrumental)",
      "romaji": "(Instrumental)",
      "en": "(Instrumental)",
      "zh": "(純音樂)"
    },
    {
      "ja": "長い旅を終えて 疲れた体で",
      "romaji": "Nagai tabi wo oete tsukareta karada de",
      "en": "Finishing a long journey, with a tired body,",
      "zh": "結束漫長旅程，帶著疲憊身軀，",
      "notes": [
        {
          "word": "旅",
          "meaning": "journey"
        }
      ]
    },
    {
      "ja": "ドアを開ければ いつもの香り",
      "romaji": "Doa wo akereba itsumo no kaori",
      "en": "When I open the door, the usual scent awaits.",
      "zh": "推開門扉，是熟悉的香氣。",
      "notes": [
        {
          "word": "香り",
          "meaning": "scent"
        }
      ]
    },
    {
      "ja": "温かい光が 私を包む",
      "romaji": "Atatakai hikari ga watashi wo tsutsumu",
      "en": "A warm light embraces me,",
      "zh": "溫暖的光芒將我環繞，",
      "notes": [
        {
          "word": "光",
          "meaning": "light"
        }
      ]
    },
    {
      "ja": "忘れていた笑顔が ここにある",
      "romaji": "Wasureteita egao ga koko ni aru",
      "en": "The forgotten smile is here.",
      "zh": "遺忘的笑容，在此重現。",
      "notes": [
        {
          "word": "笑顔",
          "meaning": "smile"
        }
      ]
    },
    {
      "ja": "おかえりなさい 私の場所へ",
      "romaji": "Okaerinasai watashi no basho e",
      "en": "Welcome home, to my place.",
      "zh": "歡迎回家，回到我的歸處。",
      "notes": [
        {
          "word": "場所",
          "meaning": "place"
        }
      ]
    },
    {
      "ja": "待っていたよ いつでも",
      "romaji": "Matteita yo itsudemo",
      "en": "I've been waiting for you, always.",
      "zh": "我一直都在等你。",
      "notes": [
        {
          "word": "待っていた",
          "meaning": "waiting"
        }
      ]
    },
    {
      "ja": "疲れた心を 癒してくれる",
      "romaji": "Tsukareta kokoro wo iyashite kureru",
      "en": "It heals my tired heart,",
      "zh": "治癒我疲憊的心，",
      "notes": [
        {
          "word": "心",
          "meaning": "heart"
        }
      ]
    },
    {
      "ja": "大切なこの家",
      "romaji": "Taisetsu na kono ie",
      "en": "This precious home.",
      "zh": "這珍貴的家。",
      "notes": [
        {
          "word": "家",
          "meaning": "home"
        }
      ]
    },
    {
      "ja": "小さな出来事も 話したくなる",
      "romaji": "Chiisana dekigoto mo hanashitaku naru",
      "en": "Even small events, I want to talk about them.",
      "zh": "即使是小事，也想與你分享。",
      "notes": [
        {
          "word": "出来事",
          "meaning": "event"
        }
      ]
    },
    {
      "ja": "笑い合える時間が 宝物",
      "romaji": "Warai aeru jikan ga takaramono",
      "en": "The time we share laughter is a treasure.",
      "zh": "彼此歡笑的時光，是我的寶物。",
      "notes": [
        {
          "word": "宝物",
          "meaning": "treasure"
        }
      ]
    },
    {
      "ja": "飾らない言葉が 心に響く",
      "romaji": "Kazaranai kotoba ga kokoro ni hibiku",
      "en": "Unadorned words resonate in my heart,",
      "zh": "不加修飾的話語，迴盪在我心。",
      "notes": [
        {
          "word": "言葉",
          "meaning": "words"
        }
      ]
    },
    {
      "ja": "安心できる場所が ここにある",
      "romaji": "Anshin dekiru basho ga koko ni aru",
      "en": "A place where I can feel at ease is here.",
      "zh": "讓我安心的歸處，就在這裡。",
      "notes": [
        {
          "word": "安心",
          "meaning": "peace of mind"
        }
      ]
    },
