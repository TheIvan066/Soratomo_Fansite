  "lyrics": [
    {
      "ja": "見慣れた景色に",
      "romaji": "Minareta keshiki ni",
      "en": "Turning my back on familiar scenery,",
      "zh": "背對著熟悉的景色，"
    },
    {
      "ja": "背を向けて歩き出す",
      "romaji": "Se wo mukete arukidasu",
      "en": "I start to walk away.",
      "zh": "我邁步向前。"
    },
    {
      "ja": "いつかの自分に",
      "romaji": "Itsuka no jibun ni",
      "en": "Waving goodbye to my past self,",
      "zh": "向過去的自己揮手，"
    },
    {
      "ja": "手を振ってさよなら",
      "romaji": "Te wo futte sayonara",
      "en": "I bid farewell.",
      "zh": "說聲再見。"
    },
    {
      "ja": "不安と期待が",
      "romaji": "Fuan to kitai ga",
      "en": "Anxiety and anticipation",
      "zh": "不安與期待"
    },
    {
      "ja": "入り混じる胸騒ぎ",
      "romaji": "Irimajiru munasawagi",
      "en": "Mix within my chest, a stirring feeling.",
      "zh": "交織在胸口，一陣騷動。"
    },
    {
      "ja": "まだ見ぬ世界へ",
      "romaji": "Mada minu sekai e",
      "en": "To a world yet unseen,",
      "zh": "向著未見的世界，"
    },
    {
      "ja": "飛び出そう今すぐ",
      "romaji": "Tobidasou ima sugu",
      "en": "Let's leap out right now!",
      "zh": "現在就飛奔而去！"
    },
    {
      "ja": "限界なんてない",
      "romaji": "Genkai nante nai",
      "en": "There are no limits,",
      "zh": "沒有什麼界限，"
    },
    {
      "ja": "Beyond the sky",
      "romaji": "Beyond the sky",
      "en": "Beyond the sky.",
      "zh": "超越天際。"
    },
    {
      "ja": "新しい出会い",
      "romaji": "Atarashii deai",
      "en": "New encounters",
      "zh": "新的邂逅"
    },
    {
      "ja": "希望の光をくれる",
      "romaji": "Kibou no hikari wo kureru",
      "en": "Give me the light of hope.",
      "zh": "給予我希望之光。"
    },
    {
      "ja": "どんな困難も",
      "romaji": "Donna konnan mo",
      "en": "No matter what difficulties,",
      "zh": "無論多麼困難，"
    },
    {
      "ja": "乗り越えていけるさ",
      "romaji": "Norikoete ikeru sa",
      "en": "I can overcome them.",
      "zh": "我都能夠跨越。"
    },
    {
      "ja": "信じる心が",
      "romaji": "Shinjiru kokoro ga",
      "en": "A believing heart",
      "zh": "相信的心"
    },
    {
      "ja": "未来を切り開く",
      "romaji": "Mirai wo kirihiraku",
      "en": "Will carve out the future.",
      "zh": "將開創未來。"
    },
    {
      "ja": "一人じゃないから",
      "romaji": "Hitori ja nai kara",
      "en": "Because I'm not alone,",
      "zh": "因為我不是一個人，"
    },
    {
      "ja": "共に歩んでいこう",
      "romaji": "Tomo ni ayunde ikou",
      "en": "Let's walk forward together.",
      "zh": "讓我們一同前行。"
    },
    {
      "ja": "Beyond the sky",
      "romaji": "Beyond the sky",
      "en": "Beyond the sky",
      "zh": "超越天際"
    },
    {
      "ja": "Beyond the sky",
