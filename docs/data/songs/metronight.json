  "lyrics": [
    {
      "ja": "※ただいま歌詞の翻訳はAIによる生成したものです。人工による翻訳は後ほどアップデートする予定です！",
      "romaji": "",
      "en": "※This translation is currently generated by AI. The refined version is coming soon!",
      "zh": "※此翻譯暫時是AI生成的。人工的翻譯會容後更新！"
    },
    {
      "ja": "ほんとうは怖いけど",
      "romaji": "Hontou ha Kowai kedo",
      "en": "I'm actually scared, but",
      "zh": "雖然真的很害怕"
    },
    {
      "ja": "始まりは誰だって",
      "romaji": "Hajimari ha Dare Datte",
      "en": "For everyone, the beginning",
      "zh": "無論是誰，開始的時候"
    },
    {
      "ja": "ここが精巧なフィクションだって",
      "romaji": "Koko ga Seikou na Fikushon Datte",
      "en": "Even if this is an elaborate fiction",
      "zh": "就算這裡是精巧的虛構故事"
    },
    {
      "ja": "そんなことどうだって構わないさ",
      "romaji": "Sonna Koto Dou Datte Kamawanai sa",
      "en": "I don't care about that at all",
      "zh": "那種事情怎樣都無所謂"
    },
    {
      "ja": "走り出せ",
      "romaji": "Hashiridase",
      "en": "Start running",
      "zh": "邁步奔跑吧"
    },
    {
      "ja": "もっとスピードを上げて",
      "romaji": "Motto Supiido wo Agete",
      "en": "Increase your speed even more",
      "zh": "再加快速度"
    },
    {
      "ja": "きっとたどり着けるから",
      "romaji": "Kitto Tadoritsukeru kara",
      "en": "Because you'll surely arrive",
      "zh": "因為一定能抵達"
    },
    {
      "ja": "時を越えて",
      "romaji": "Toki wo Koete",
      "en": "Cross over time",
      "zh": "跨越時間"
    },
    {
      "ja": "夢の世界へ",
      "romaji": "Yume no Sekai e",
      "en": "To the world of dreams",
      "zh": "前往夢想的世界"
    },
    {
      "ja": "悲しいことなど何にもないさ",
      "romaji": "Kanashii Koto Nado Nani mo Nai sa",
      "en": "There's nothing sad at all",
      "zh": "悲傷的事一點也不存在"
    },
    {
      "ja": "手をとって何処までもゆこう",
      "romaji": "Te wo Totte Doko made mo Yukou",
      "en": "Take my hand and let's go anywhere",
      "zh": "牽起手，無論何處都一起去吧"
    },
    {
      "ja": "ほんとうは怖いけど",
