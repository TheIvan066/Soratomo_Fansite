        },
        {
          "c": "Coming Soon!",
          "t": "あく！せく！アク！セス！あっ！＼！！恐竜さん！！／"
        },
        {
          "c": "Coming Soon!",
          "t": "あく！せく！アク！セス！あっ！＼！！Success！！／"
        },
        {
          "c": "Coming Soon!",
          "t": "「時代はいま戦国乱世のIoT」"
        },
        {
          "c": "Coming Soon!",
          "t": "「何のニュースに感化されちゃったんだろ？」"
        },
        {
          "c": "Coming Soon!",
          "t": "「だってわたしたちは！」"
        },
        {
          "c": "Coming Soon!",
          "t": "「バーチャルファミリーでいっ！」"
        },
        {
          "c": "Coming Soon!",
          "t": "「今日はそのへんズバッと斬り込みたいな…」"
        },
        {
          "c": "Coming Soon!",
          "t": "「センシティブワードはそっとスルー推奨」"
        },
        {
          "c": "Coming Soon!",
          "t": "「当たり前だけど大事です！」"
        },
        {
          "c": "Coming Soon!",
          "t": "「つまり我々は時代の寵児」"
        },
        {
          "c": "Coming Soon!",
          "t": "「それゆえにリスキー」"
        },
        {
          "c": "Coming Soon!",
          "t": "「予期せぬ炎のなかでも」"
        },
        {
          "c": "Coming Soon!",
          "t": "「たたかわなければならないッ！！」"
        },
        {
          "c": "Coming Soon!",
          "t": "「BAN★BAN★いきますよ～！」"
        },
        {
          "c": "Coming Soon!",
          "t": "「やめてぇえーッ！」"
        },
        {
          "c": "Coming Soon!",
          "t": "「あぇっ…いったんサビです！」"
        },
        {
          "c": "Coming Soon!",
          "t": "ようこそ最先端　(えいぷりる)"
        },
        {
          "c": "Coming Soon!",
          "t": "V・V・斬り込みます！　(ふーるず)"
        },
        {
          "c": "Coming Soon!",
          "t": "配信枠を飛び出す大躍進！"
        },
        {
          "c": "Coming Soon!",
          "t": "「まさにコレ！」"
        },
        {
          "c": "Coming Soon!",
          "t": "常識をアップデート　(わんもあ)"
        },
        {
          "c": "Coming Soon!",
          "t": "BAN★BAN★BAN★回避してV☆　(ふふふふ)"
        },
        {
          "c": "Coming Soon!",
          "t": "進め！起こせ！　(えいぷりるふーるず)"
        },
        {
          "c": "Coming Soon!",
          "t": "センセーション！"
        },
        {
          "c": "Coming Soon!",
          "t": "悪・即・検・索！！えっ！！　＼！1万件？！／"
        },
        {
          "c": "Coming Soon!",
          "t": "あい？まい？愛！？舞！？サッ！＼！！回避！！／"
        },
        {
          "c": "Coming Soon!",
          "t": "「みんな一緒に戦国乱世ごっこしよう？」"
        },
        {
          "c": "Coming Soon!",
          "t": "「職業選択の自由行使します」"
        },
        {
          "c": "Coming Soon!",
          "t": "「そんなこと言わずに～」"
        },
        {
          "c": "Coming Soon!",
          "t": "「つれないなぁ～」"
        },
        {
          "c": "Coming Soon!",
          "t": "「なんかすごい時代な気がしてきた」"
        },
        {
          "c": "Coming Soon!",
          "t": "「これからどう変わっていくんだろうね？」"
        },
        {
          "c": "Coming Soon!",
          "t": "「それはパンドラの箱では…？」"
        },
        {
          "c": "Coming Soon!",
          "t": "「あぁ！『はい』を選ぶと」"
        },
        {
          "c": "Coming Soon!",
          "t": "「違う違う」"
        },
        {
          "c": "Coming Soon!",
          "t": "「開けちゃいけないんですよぉ」"
        },
        {
          "c": "Coming Soon!",
          "t": "「それこそ斬り込まないと！」"
        },
        {
          "c": "Coming Soon!",
          "t": "「このまま取り残されちゃうかもよ～？」"
        },
        {
          "c": "Coming Soon!",
          "t": "「でも、でも…ッ！」"
        },
        {
          "c": "Coming Soon!",
          "t": "「…滅びる原因は、自らの内にある」"
        },
        {
          "c": "Coming Soon!",
          "t": "「そんなぁ！！わたし取り残されたくないです！！」"
        },
        {
          "c": "Coming Soon!",
          "t": "「ならば奮起せよ！アプデするのだ！」"
        },
        {
          "c": "Coming Soon!",
          "t": "「そうだそうだ！」"
        },
