  "lyrics": [
    {
      "ja": "※ただいま歌詞の翻訳はAIによる生成したものです。人工による翻訳は後ほどアップデートする予定です！",
      "romaji": "",
      "en": "※This translation is currently generated by AI. The refined version is coming soon!",
      "zh": "※此翻譯暫時是AI生成的。人工的翻譯會容後更新！"
    },
    {
      "ja": "明日も明後日もきっと",
      "romaji": "Ashita mo Asatte mo Kitto",
      "en": "Tomorrow and the day after, surely",
      "zh": "明天也好後天也好，一定"
    },
    {
      "ja": "ひとりじゃ辿り着けない",
      "romaji": "Hitori ja Tadoritsukenai",
      "en": "I can't reach it alone",
      "zh": "一個人無法抵達"
    },
    {
      "ja": "ナミダの数の想いだけ",
      "romaji": "Namida no Kazu no Omoi Dake",
      "en": "Only as many feelings as there are tears",
      "zh": "只有與眼淚數量相等的思念"
    },
    {
      "ja": "伝えたい",
      "romaji": "Tsutaetai",
      "en": "I want to convey",
      "zh": "想要傳達"
    },
    {
      "ja": "あの日始まったキズナ結ぶ戸惑いの日々",
      "romaji": "Ano Hi Hajimatta Kizuna Musubu Tomadoi no Hibi",
      "en": "The days of confusion that tie the bond that began that day",
      "zh": "那天開始的羈絆所繫起的迷惘日子"
    },
    {
      "ja": "気が付けば近付くココロの距離",
      "romaji": "Ki ga Tsukeba Chikazuku Kokoro no Kyori",
      "en": "Before I knew it, the distance between our hearts grew closer",
      "zh": "回過神來，心與心的距離拉近了"
    },
    {
      "ja": "上手く紡げないコトバ　だけど不器用なりに",
      "romaji": "Umaku Tsumugenai Kotoba Dakedo Bukiyou Nari ni",
      "en": "Words I can't spin well—but in my own clumsy way",
      "zh": "無法好好編織的話語，但我以笨拙的方式"
    },
    {
      "ja": "歩いてきた軌跡　巡る　奇跡",
      "romaji": "Aruite Kita Kiseki Meguru Kiseki",
      "en": "The轨迹 I've walked—circulating miracles",
      "zh": "一路走來的軌跡，循環的奇蹟"
    },
    {
      "ja": "いつか枯れる運命でも　(Don't lose yourself)",
      "romaji": "Itsuka Kareru Unmei demo (Don't Lose Yourself)",
      "en": "Even if it's a destiny that will someday wither (don't lose yourself)",
      "zh": "即使終將枯萎的命運（Don't lose yourself）"
    },
    {
      "ja": "咲き誇る花でいたい",
      "romaji": "Sakihokoru Hana de Itai",
      "en": "I want to be a flower in full bloom",
      "zh": "想成為盛開綻放的花"
    },
    {
      "ja": "いつか褪せる想いでも　(Going your own way)",
      "romaji": "Itsuka Aseru Omoi demo (Going Your Own Way)",
      "en": "Even if these feelings will someday fade (going your own way)",
      "zh": "即使思念終將褪色（Going your own way）"
    },
    {
      "ja": "まだ夢見たいから",
      "romaji": "Mada Yumemitai kara",
      "en": "Because I still want to dream",
      "zh": "因為還想繼續做夢"
    },
    {
      "ja": "そうでしょ？",
      "romaji": "Sou Desho?",
      "en": "Right?",
      "zh": "對吧？"
    },
    {
      "ja": "明日も明後日も",
      "romaji": "Ashita mo Asatte mo",
      "en": "Tomorrow and the day after",
      "zh": "明天也好後天也好"
    },
    {
      "ja": "きっとひとりじゃ辿り着けない",
      "romaji": "Kitto Hitori ja Tadoritsukenai",
      "en": "Surely I can't reach it alone",
      "zh": "一定一個人無法抵達"
    },
    {
      "ja": "ナミダの数の想いだけ",
      "romaji": "Namida no Kazu no Omoi Dake",
      "en": "Only as many feelings as there are tears",
      "zh": "只有與眼淚數量相等的思念"
    },
    {
      "ja": "ココロに　(きっと)　溢れてる",
      "romaji": "Kokoro ni (Kitto) Afureteru",
      "en": "Are overflowing in my heart (surely)",
      "zh": "在心中（一定）滿溢而出"
    },
    {
      "ja": "それでも",
      "romaji": "Sore demo",
      "en": "Even so",
      "zh": "即使如此"
    },
    {
      "ja": "最後は泡のように",
      "romaji": "Saigo ha Awa no You ni",
      "en": "If in the end, like bubbles",
      "zh": "最後若像泡沫般"
    },
    {
      "ja": "いつか消えてしまうのなら",
      "romaji": "Itsuka Kiete Shimau no Nara",
      "en": "They'll someday disappear",
      "zh": "總有一天會消失的話"
    },
    {
      "ja": "伝え足りないキモチ",
      "romaji": "Tsutae Tarinai Kimochi",
      "en": "These feelings I haven't conveyed enough",
      "zh": "尚未傳達足夠的心情"
    },
    {
      "ja": "キミに届くように",
      "romaji": "Kimi ni Todoku You ni",
      "en": "So that they reach you",
      "zh": "願能傳達給你"
    },
    {
      "ja": "そっといまに願う",
      "romaji": "Sotto Ima ni Negau",
      "en": "I quietly wish upon this moment",
      "zh": "悄悄地向現在許願"
    },
    {
      "ja": "振り返れば痕跡　(痕跡)",
      "romaji": "Furikaereba Konseki (Konseki)",
      "en": "Looking back, there are traces (traces)",
      "zh": "回頭望去是痕跡（痕跡）"
    },
    {
      "ja": "あの日見た可能性　(可能性)",
      "romaji": "Ano Hi Mita Kanousei (Kanousei)",
      "en": "The possibilities I saw that day (possibilities)",
      "zh": "那天看見的可能性（可能性）"
    },
    {
      "ja": "過去は未来の証明　(証明)",
      "romaji": "Kako ha Mirai no Shoumei (Shoumei)",
      "en": "The past is proof of the future (proof)",
      "zh": "過去是未來的證明（證明）"
    },
    {
      "ja": "ふいに重なる手と手",
      "romaji": "Fui ni Kasanaru Te to Te",
      "en": "Hands that suddenly overlap",
      "zh": "不經意交疊的手與手"
    },
    {
      "ja": "ずっとうまく伝わらない",
      "romaji": "Zutto Umaku Tsutawaranai",
      "en": "It never gets through well",
      "zh": "一直無法好好傳達"
    },
    {
      "ja": "でもいつだって感じてたよ",
      "romaji": "Demo Itsu Datte Kanjiteta yo",
      "en": "But I've always felt it",
      "zh": "但無論何時都感受得到"
    },
    {
      "ja": "きっと出逢いの意味は",
      "romaji": "Kitto Deai no Imi ha",
      "en": "Surely the meaning of our meeting",
      "zh": "相遇的意義一定"
    },
    {
      "ja": "僕らが決めるもの",
      "romaji": "Bokura ga Kimeru Mono",
      "en": "Is something we decide",
      "zh": "是由我們決定的"
    },
    {
      "ja": "そうでしょ？",
      "romaji": "Sou Desho?",
