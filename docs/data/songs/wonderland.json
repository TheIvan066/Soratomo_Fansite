  "lyrics": [
    {
      "ja": "※ただいま歌詞の翻訳はAIによる生成したものです。人工による翻訳は後ほどアップデートする予定です！",
      "romaji": "",
      "en": "※This translation is currently generated by AI. The refined version is coming soon!",
      "zh": "※此翻譯暫時是AI生成的。人工的翻譯會容後更新！"
    },
    {
      "ja": "奇跡のような毎日を",
      "romaji": "Kiseki no You na Mainichi wo",
      "en": "These miracle-like days",
      "zh": "宛如奇蹟的每一天"
    },
    {
      "ja": "君と過ごしたいよ",
      "romaji": "Kimi to Sugoshitai yo",
      "en": "I want to spend them with you",
      "zh": "好想和你一起度過"
    },
    {
      "ja": "一緒に It's a wonderland",
      "romaji": "Issho ni It's a Wonderland",
      "en": "Together, it's a wonderland",
      "zh": "一起出發，It's a wonderland"
    },
    {
      "ja": "憧れていた夢のせて",
      "romaji": "Akogarete Ita Yume Nosete",
      "en": "Riding on the dreams I've longed for",
      "zh": "乘著嚮往已久的夢想"
    },
    {
      "ja": "君の笑顔に会いに行きたいよ",
      "romaji": "Kimi no Egao ni Ai ni Ikitai yo",
      "en": "I want to go meet your smile",
      "zh": "好想去見你的笑容"
    },
    {
      "ja": "大好きな気持ちだけ",
      "romaji": "Daisuki na Kimochi Dake",
      "en": "Only this feeling of loving you",
      "zh": "只有這份最喜歡的心情"
    },
    {
      "ja": "変わらずに抱きしめて",
      "romaji": "Kawarazu ni Dakishimete",
      "en": "Hold it close, unchanging",
      "zh": "始終不變地緊抱著"
    },
    {
      "ja": "魔法のようなキラメキ",
      "romaji": "Mahou no You na Kirameki",
      "en": "A magical sparkle",
      "zh": "魔法般的閃耀光芒"
    },
    {
      "ja": "ずっと感じていたいの",
      "romaji": "Zutto Kanjite Itai no",
      "en": "I want to feel it forever",
      "zh": "想一直感受下去"
    },
    {
      "ja": "いまファンタスティック",
      "romaji": "Ima Fantasutikku",
      "en": "Now it's fantastic",
      "zh": "此刻如此奇幻"
    },
    {
      "ja": "奇跡ロマンティック",
      "romaji": "Kiseki Romantikku",
      "en": "A miraculous romance",
      "zh": "奇蹟般的浪漫"
    },
    {
      "ja": "希望見せて",
      "romaji": "Kibou Misete",
      "en": "Show me hope",
      "zh": "讓我看見希望"
    },
    {
      "ja": "明日へ駆け抜けて",
      "romaji": "Ashita e Kakenukete",
      "en": "And dash toward tomorrow",
      "zh": "奔向明天"
    },
    {
      "ja": "そうドリーミング　集めて",
      "romaji": "Sou Doriimingu Atsumete",
      "en": "Yes, gather up the dreaming",
      "zh": "收集起夢想"
    },
    {
      "ja": "イルミネーション",
      "romaji": "Irumineeshon",
      "en": "Illumination",
      "zh": "絢爛的燈飾"
    },
    {
      "ja": "探そう　夢のドア",
      "romaji": "Sagasou Yume no Doa",
      "en": "Let's search for the door of dreams",
      "zh": "尋找吧，夢想之門"
    },
    {
      "ja": "明日はもっと世界は輝くよ",
      "romaji": "Ashita ha Motto Sekai ha Kagayaku yo",
      "en": "Tomorrow the world will shine even more",
      "zh": "明天的世界會更加閃耀"
    },
    {
      "ja": "キミ次第さ It's a wonderland",
      "romaji": "Kimi Shidai sa It's a Wonderland",
      "en": "It's up to you—it's a wonderland",
      "zh": "全都取決於你，It's a wonderland"
    },
    {
      "ja": "午前0時　鐘が鳴る",
      "romaji": "Gozen Reiji Kane ga Naru",
      "en": "At midnight, the bell rings",
      "zh": "午夜零時，鐘聲響起"
    },
    {
      "ja": "素敵な馬車で走るよプリンセス",
      "romaji": "Suteki na Basha de Hashiru yo Purinsesu",
      "en": "I'll ride in a lovely carriage, princess",
      "zh": "乘著華麗的馬車奔馳，公主"
    },
    {
      "ja": "夜空から会いに行くよ",
