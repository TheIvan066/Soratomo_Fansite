    },
    {
      "ja": "「ちょいとそこ往く、みなみな様よ～」",
      "romaji": "「Choi to Soko Iku, Minamina Sama yo~」",
      "en": "\"Hey there, everyone passing by~\"",
      "zh": "「稍微路過那裡的各位大人們～」"
    },
    {
      "ja": "「僕らと一緒に、おどらな～い？」",
      "romaji": "「Bokura to Issho ni, Odorana~i?」",
      "en": "\"Won't you dance together with us~?\"",
      "zh": "「要不要和我們一起跳舞呢～？」"
    },
    {
      "ja": "「さぁ、お手を拝借～～ぱぱんがぱん　はい」",
      "romaji": "「Saa, Ote wo Haishaku~~ Papan Ga Pan Hai」",
      "en": "\"Now, if I may borrow your hands~~ clap clap clap, yes\"",
      "zh": "「來吧，借一下各位的手～～啪啪啪，好」"
    },
    {
      "ja": "ちょうちん灯れば　笑顔が集う",
      "romaji": "Chouchin Tomoreba Egao ga Tsudou",
      "en": "When the lanterns are lit, smiles gather",
      "zh": "燈籠點亮，笑容聚集"
    },
    {
      "ja": "ホロメン音頭　(あーよいしょ)",
      "romaji": "Horomen Ondo (Aa Yoisho)",
      "en": "The Holomen ondo (ah, heave-ho)",
      "zh": "Holo成員音頭（啊，嘿咻）"
    },
    {
      "ja": "うちわ　わたあめ　かき氷　だね",
      "romaji": "Uchiwa Wataame Kaki Koori Da ne",
      "en": "Fans, cotton candy, shaved ice—right?",
      "zh": "團扇、棉花糖、刨冰呢"
    },
    {
      "ja": "パーリラ　パーリラ　わんこも踊る　(そーれ)",
      "romaji": "Paarira Paarira Wanko mo Odoru (Soore)",
      "en": "Parira, parira—even the doggy dances (there!)",
      "zh": "啪哩啦 啪哩啦，小狗也跳舞（嘿）"
    },
    {
