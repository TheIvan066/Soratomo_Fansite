      "en": "Hey wait a minute!",
      "zh": "Hey wait a minute！"
    },
    {
      "ja": "BEEP BEEP",
      "romaji": "BEEP BEEP",
      "en": "Beep beep",
      "zh": "BEEP BEEP"
    },
    {
      "ja": "何度でもI say",
      "romaji": "Nando demo I Say",
      "en": "No matter how many times, I say",
      "zh": "無論多少次 I say"
    },
    {
      "ja": "答えてよGimme one more chance",
      "romaji": "Kotaete yo Gimme One More Chance",
      "en": "Answer me—gimme one more chance",
      "zh": "回答我啊，Gimme one more chance"
    },
    {
      "ja": "1秒だけで良い",
      "romaji": "Ichibyou Dake de Ii",
      "en": "Just one second is enough",
      "zh": "只要一秒就好"
    },
    {
      "ja": "私にちょうだい",
      "romaji": "Watashi ni Choudai",
      "en": "Give it to me",
      "zh": "給我吧"
    },
    {
      "ja": "(Are you the one？)",
      "romaji": "(Are You the One?)",
      "en": "(Are you the one?)",
      "zh": "（Are you the one？）"
    },
    {
      "ja": "いつからFeeling (Feeling)",
      "romaji": "Itsu kara Feeling (Feeling)",
      "en": "Since when has this feeling (feeling)",
      "zh": "從何時開始的 Feeling（Feeling）"
    },
    {
      "ja": "止まらないYou&Me",
      "romaji": "Tomaranai You & Me",
      "en": "Won't stop—you and me",
      "zh": "停不下來 You&Me"
    },
    {
      "ja": "Nobody else in my vision",
      "romaji": "Nobody Else in My Vision",
      "en": "Nobody else in my vision",
      "zh": "Nobody else in my vision"
    },
    {
      "ja": "上がる温度、脈のスピードはFast (So fast)",
      "romaji": "Agari Onndo, Myaku no Supiido ha Fast (So Fast)",
      "en": "Rising temperature, my pulse speed is fast (so fast)",
      "zh": "上升的溫度，脈搏的速度是 Fast（So fast）"
    },
    {
      "ja": "このレースいつもLast (Oh last)",
      "romaji": "Kono Reesu Itsumo Last (Oh Last)",
      "en": "This race is always last (oh last)",
      "zh": "這場比賽總是 Last（Oh last）"
    },
    {
      "ja": "クタクタでも",
      "romaji": "Kutakuta demo",
      "en": "Even if I'm exhausted",
      "zh": "即使筋疲力盡"
    },
    {
      "ja": "受けて立とう I'm ready now",
      "romaji": "Uketetatou I'm Ready Now",
      "en": "I'll take you on—I'm ready now",
      "zh": "接受挑戰吧，I'm ready now"
    },
    {
      "ja": "目が回る暗いMaze",
      "romaji": "Me ga Mawaru Kurai Maze",
      "en": "A dizzying, dark maze",
      "zh": "令人眼花撩亂的暗黑 Maze"
    },
    {
      "ja": "出口どこ？探してるDays",
      "romaji": "Deguchi Doko? Sagashiteru Days",
      "en": "Where's the exit? Days spent searching",
      "zh": "出口在哪？尋找著的日子 Days"
    },
