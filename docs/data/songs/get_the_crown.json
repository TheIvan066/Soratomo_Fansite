    {
      "ja": "ここが限界？誰のセリフ？",
      "romaji": "Koko ga Genkai? Dare no Serifu?",
      "en": "This is the limit? Whose line is that?",
      "zh": "這裡就是極限？這是誰的台詞？"
    },
    {
      "ja": "テンプレな　煽り文句じゃ",
      "romaji": "Tenpure na Aori Monku ja",
      "en": "With template provocation lines",
      "zh": "用千篇一律的煽動話語"
    },
    {
      "ja": "No flinch No flinch",
      "romaji": "No Flinch No Flinch",
      "en": "No flinch, no flinch",
      "zh": "No flinch No flinch"
    },
    {
      "ja": "届きもしない",
      "romaji": "Todoki mo Shinai",
      "en": "They won't even reach me",
      "zh": "根本觸及不到"
    },
    {
      "ja": "It's up to me",
      "romaji": "It's Up to Me",
      "en": "It's up to me",
      "zh": "It's up to me"
    },
    {
      "ja": "お・わ・か・り？",
      "romaji": "O Wa Ka Ri?",
      "en": "Understood?",
      "zh": "瞭・解・了・嗎？"
    },
    {
      "ja": "Hey Go！　ただ夢中に　Move on",
      "romaji": "Hey Go! Tada Muchuu ni Move On",
      "en": "Hey, go! Just absorbed in it—move on",
      "zh": "Hey Go！只是忘我地 Move on"
    },
    {
      "ja": "進む私を　誰も",
      "romaji": "Susumu Watashi wo Dare mo",
      "en": "No one can stop me",
      "zh": "誰也無法阻止"
    },
    {
      "ja": "止められやしない(Come here)",
      "romaji": "Tomerare Ya Shinai (Come Here)",
      "en": "As I move forward (come here)",
      "zh": "向前邁進的我（Come here）"
    },
    {
      "ja": "壁は高ければ　高い方がいい",
      "romaji": "Kabe ha Takakereba Takai Hou ga Ii",
      "en": "If the wall is high, the higher the better",
      "zh": "牆若很高，越高越好"
    },
    {
      "ja": "I just need to get better",
      "romaji": "I Just Need to Get Better",
      "en": "I just need to get better",
      "zh": "I just need to get better"
    },
    {
      "ja": "GET THE CROWN(Hey！)",
      "romaji": "GET THE CROWN (Hey!)",
      "en": "Get the crown (hey!)",
      "zh": "GET THE CROWN（Hey！）"
    },
    {
      "ja": "With these hands",
      "romaji": "With These Hands",
      "en": "With these hands",
      "zh": "With these hands"
    },
    {
      "ja": "用意された頂じゃ　ものたんない",
      "romaji": "Youi Sareta Itadaki ja Monotannai",
      "en": "A prepared summit just isn't enough",
      "zh": "被準備好的頂點根本不夠"
    },
    {
      "ja": "Stand up(Hey！)",
      "romaji": "Stand Up (Hey!)",
      "en": "Stand up (hey!)",
      "zh": "Stand up（Hey！）"
    },
    {
      "ja": "Even if fall",
      "romaji": "Even If Fall",
      "en": "Even if I fall",
      "zh": "Even if fall"
    },
    {
      "ja": "昨日の自分に　興味はない",
