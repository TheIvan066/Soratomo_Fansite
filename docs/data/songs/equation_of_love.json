  "lyrics": [
    {
      "ja": "※ただいま歌詞の翻訳はAIによる生成したものです。人工による翻訳は後ほどアップデートする予定です！",
      "romaji": "",
      "en": "※This translation is currently generated by AI. The refined version is coming soon!",
      "zh": "※此翻譯暫時是AI生成的。人工的翻譯會容後更新！"
    },
    {
      "ja": "今日もあなたをリサーチ",
      "romaji": "Kyou mo Anata wo Risaachi",
      "en": "Today too, I research you",
      "zh": "今天也在研究你"
    },
    {
      "ja": "答え求め　視線が彷徨う",
      "romaji": "Kotae Motome Shisen ga Samayou",
      "en": "Seeking answers, my gaze wanders",
      "zh": "尋求答案，視線徘徊不定"
    },
    {
      "ja": "恋の成分　愛の検分",
      "romaji": "Koi no Seibun Ai no Kenbun",
      "en": "The components of love, the inspection of affection",
      "zh": "戀愛的成分，愛情的檢驗"
    },
    {
      "ja": "分からない事だらけ",
      "romaji": "Wakaranai Koto Darake",
      "en": "Full of things I don't understand",
      "zh": "滿是搞不懂的事情"
    },
    {
      "ja": "間違い探しに明け暮れる日々が",
      "romaji": "Machigai Sagashi ni Akekureru Hibi ga",
      "en": "Days spent searching for mistakes",
      "zh": "日復一日尋找著錯誤"
    },
    {
      "ja": "終わらない　終われない",
      "romaji": "Owaranai Owarenai",
      "en": "They won't end, I can't end them",
      "zh": "不會結束，也無法結束"
    },
    {
      "ja": "さあ始めよう",
      "romaji": "Saa Hajimeyou",
      "en": "Now, let's begin",
      "zh": "來吧，開始吧"
    },
    {
      "ja": "恋の方程式",
      "romaji": "Koi no Houteishiki",
      "en": "The equation of love",
      "zh": "戀愛的方程式"
    },
    {
      "ja": "今日こそ解き明かすから",
      "romaji": "Kyou Koso Tokiakasu kara",
      "en": "Today, for sure, I'll solve it",
      "zh": "今天一定要解開"
    },
    {
      "ja": "測定不能　高まる心拍",
      "romaji": "Sokutei Funou Takamaru Shinpaku",
      "en": "Unmeasurable, my rising heartbeat",
      "zh": "無法測定，加速的心跳"
    },
    {
      "ja": "解けない難題を",
      "romaji": "Tokenai Nandai wo",
      "en": "This unsolvable puzzle",
      "zh": "解不開的難題"
    },
    {
      "ja": "恋はいつも未解決",
      "romaji": "Koi ha Itsumo Mikaiketsu",
      "en": "Love is always unsolved",
      "zh": "戀愛總是懸而未解"
    },
    {
      "ja": "今日こそ追い詰めるから",
      "romaji": "Kyou Koso Oitsumeru kara",
      "en": "Today, for sure, I'll corner it",
      "zh": "今天一定要追到底"
    },
    {
      "ja": "あなたよりも先に",
      "romaji": "Anata yori mo Saki ni",
      "en": "Before you do",
      "zh": "比你更早一步"
    },
    {
      "ja": "証明するから",
      "romaji": "Shoumei Suru kara",
      "en": "I'll prove it",
      "zh": "證明給你看"
    },
    {
      "ja": "今日もあなたにアタック",
      "romaji": "Kyou mo Anata ni Atakku",
      "en": "Today too, I attack you",
      "zh": "今天也向你發動攻勢"
    },
    {
      "ja": "誤魔化してる　視線が彷徨う",
      "romaji": "Gomakashiteru Shisen ga Samayou",
      "en": "Hiding it, my gaze wanders",
      "zh": "掩飾著，視線徘徊不定"
    },
    {
      "ja": "恋の駆け引き　愛の線引き",
      "romaji": "Koi no Kakehiki Ai no Senbiki",
      "en": "The tactics of love, the boundaries of affection",
      "zh": "戀愛的策略，愛情的界線"
    },
    {
      "ja": "分からない事だらけ",
      "romaji": "Wakaranai Koto Darake",
      "en": "Full of things I don't understand",
      "zh": "滿是搞不懂的事情"
    },
    {
      "ja": "足りないピースを当てはめる日々が",
      "romaji": "Tarinai Piisu wo Atehameru Hibi ga",
      "en": "Days of fitting in the missing pieces",
      "zh": "將缺失的拼片填補進去的日子"
    },
    {
      "ja": "終わらない　終われない",
      "romaji": "Owaranai Owarenai",
      "en": "They won't end, I can't end them",
      "zh": "不會結束，也無法結束"
    },
    {
      "ja": "さあ始めよう",
      "romaji": "Saa Hajimeyou",
      "en": "Now, let's begin",
      "zh": "來吧，開始吧"
    },
    {
      "ja": "恋する途中式",
      "romaji": "Koisuru Tochuu Shiki",
      "en": "The working equation of falling in love",
      "zh": "戀愛中的計算式"
    },
    {
      "ja": "今日こそ書き上げるから",
      "romaji": "Kyou Koso Kakiageru kara",
      "en": "Today, for sure, I'll write it all out",
      "zh": "今天一定要寫完"
    },
    {
      "ja": "確認不要　赤らむほっぺは",
      "romaji": "Kakunin Fuyou Akaramu Hoppe ha",
      "en": "No need to confirm—these blushing cheeks",
      "zh": "無需確認，泛紅的臉頰"
    },
    {
      "ja": "あなたのせいだからね",
      "romaji": "Anata no Sei Da kara ne",
      "en": "Are your fault, you know",
      "zh": "都是你害的喔"
    },
    {
      "ja": "恋はいつも未完成",
      "romaji": "Koi ha Itsumo Mikansei",
      "en": "Love is always incomplete",
      "zh": "戀愛總是未完成"
    },
    {
      "ja": "今日こそ振り向かせるから",
      "romaji": "Kyou Koso Furimukaseru kara",
      "en": "Today, for sure, I'll make you turn around",
      "zh": "今天一定要讓你回頭"
    },
    {
      "ja": "あなたよりも先に",
      "romaji": "Anata yori mo Saki ni",
      "en": "Before you do",
      "zh": "比你更早一步"
    },
    {
      "ja": "証明するから",
