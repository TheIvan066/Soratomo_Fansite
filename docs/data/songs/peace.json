  "lyrics": [
    {
      "ja": "※ただいま歌詞の翻訳はAIによる生成したものです。人工による翻訳は後ほどアップデートする予定です！",
      "romaji": "",
      "en": "※This translation is currently generated by AI. The refined version is coming soon!",
      "zh": "※此翻譯暫時是AI生成的。人工的翻譯會容後更新！"
    },
    {
      "ja": "はち切れそうな想いが　僕らの声が",
      "romaji": "Hachikiresou na Omoi ga Bokura no Koe ga",
      "en": "These feelings about to burst—our voices",
      "zh": "快要滿溢而出的思念，我們的聲音"
    },
    {
      "ja": "どこまで届くか試そうか",
      "romaji": "Doko made Todoku ka Tamesou ka",
      "en": "Shall we try how far they can reach?",
      "zh": "來試試能傳達到多遠吧"
    },
    {
      "ja": "放って",
      "romaji": "Hanatte",
      "en": "Release them",
      "zh": "釋放出去"
    },
    {
      "ja": "Yeah!",
      "romaji": "Yeah!",
      "en": "Yeah!",
      "zh": "Yeah！"
    },
    {
      "ja": "始まりは　何気なくてシンプルで",
      "romaji": "Hajimari ha Nanigenakute Shinpuru de",
      "en": "The beginning was casual and simple",
      "zh": "開始是那麼不經意又單純"
    },
    {
      "ja": "思いつきのような　夢のような",
      "romaji": "Omoitsuki no You na Yume no You na",
      "en": "Like a whim, like a dream",
      "zh": "像一時興起，又像夢境"
    },
    {
      "ja": "曖昧なライン",
      "romaji": "Aimai na Rain",
      "en": "An ambiguous line",
      "zh": "曖昧的界線"
    },
    {
      "ja": "それらは　宙を舞って瞬いて",
      "romaji": "Sorera ha Chuu wo Matte Matataite",
      "en": "They danced in the air and sparkled",
      "zh": "它們在空中飛舞、閃爍"
    },
    {
      "ja": "いつの間にか　強く大きく 育っていた",
      "romaji": "Itsu no Ma ni ka Tsuyoku Ookiku Sodatte Ita",
      "en": "Before we knew it, they had grown strong and big",
      "zh": "不知不覺間，已變得堅強而壯大"
    },
    {
      "ja": "僕ら 明日を願って　夢に向かって",
      "romaji": "Bokura Ashita wo Negatte Yume ni Mukatte",
      "en": "We wish for tomorrow, facing our dreams",
      "zh": "我們祈願明天，朝向夢想"
    },
    {
      "ja": "空を仰いで　青さを知って",
      "romaji": "Sora wo Aoide Aosa wo Shitte",
      "en": "Looking up at the sky, learning its blue",
      "zh": "仰望天空，知曉了蔚藍"
    },
    {
      "ja": "目と目が合って　次元を越えて",
      "romaji": "Me to Me ga Atte Jigen wo Koete",
      "en": "Our eyes meet, transcending dimensions",
      "zh": "眼神交會，超越次元"
    },
    {
      "ja": "君の声を待っている",
      "romaji": "Kimi no Koe wo Matte Iru",
      "en": "I'm waiting for your voice",
      "zh": "等待著你的聲音"
    },
    {
      "ja": "明日を願って　夢に向かって",
      "romaji": "Ashita wo Negatte Yume ni Mukatte",
      "en": "Wishing for tomorrow, facing our dreams",
      "zh": "祈願明天，朝向夢想"
    },
