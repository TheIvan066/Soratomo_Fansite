  "lyrics": [
    {
      "ja": "※ただいま歌詞の翻訳はAIによる生成したものです。人工による翻訳は後ほどアップデートする予定です！",
      "romaji": "",
      "en": "※This translation is currently generated by AI. The refined version is coming soon!",
      "zh": "※此翻譯暫時是AI生成的。人工的翻譯會容後更新！"
    },
    {
      "ja": "信じ合う仲間と一緒に",
      "romaji": "Shinjiau Nakama to Issho ni",
      "en": "Together with friends who trust each other",
      "zh": "與互相信任的夥伴一起"
    },
    {
      "ja": "挑戦の狼煙をあげよう",
      "romaji": "Chousen no Noroshi wo Ageyou",
      "en": "Let's raise the signal fire of challenge",
      "zh": "升起挑戰的狼煙吧"
    },
    {
      "ja": "終わらない",
      "romaji": "Owaranai",
      "en": "Never-ending",
      "zh": "不會結束的"
    },
    {
      "ja": "青春に",
      "romaji": "Seishun ni",
      "en": "To youth",
      "zh": "青春"
    },
    {
      "ja": "Wow",
      "romaji": "Wow",
      "en": "Wow",
      "zh": "Wow"
    },
    {
      "ja": "Boy's & Girls",
      "romaji": "Boy's & Girls",
      "en": "Boys & girls",
      "zh": "Boy's & Girls"
    },
    {
      "ja": "羞恥心は捨てて Hey Jump！",
      "romaji": "Shuchishin ha Sutete Hey Jump!",
      "en": "Throw away your shame—hey, jump!",
      "zh": "拋開羞恥心，Hey Jump！"
    },
    {
      "ja": "みんなで揃えばCool Jump！Jump！",
      "romaji": "Minna de Soroeba Cool Jump! Jump!",
      "en": "When everyone's together, cool jump! Jump!",
      "zh": "大家齊聚就 Cool Jump！Jump！"
    },
    {
      "ja": "光る水滴こぼれ落ちて",
      "romaji": "Hikaru Suiteki Koboreochite",
      "en": "Shining water droplets spill and fall",
      "zh": "閃亮的水滴灑落而下"
    },
    {
      "ja": "青春感じている猛暑日",
      "romaji": "Seishun Kanjite Iru Mousho Bi",
      "en": "Feeling youth on this scorching hot day",
      "zh": "感受著青春的酷暑日"
    },
    {
      "ja": "あっちゅ～！",
      "romaji": "Acchuu!",
      "en": "Hot~!",
      "zh": "好燙～！"
    },
    {
      "ja": "成長した姿を見せたい",
      "romaji": "Seichou Shita Sugata wo Misetai",
      "en": "I want to show how much I've grown",
      "zh": "想讓大家看見成長後的模樣"
    },
    {
      "ja": "リハは完璧",
      "romaji": "Riha ha Kanpeki",
      "en": "Rehearsal was perfect",
      "zh": "彩排完美無缺"
    },
    {
      "ja": "本番はもっと全力でHigh！High！",
      "romaji": "Honban ha Motto Zenryoku de High! High!",
      "en": "The real thing will be even more full-power—high! High!",
      "zh": "正式上場要更加全力 High！High！"
    },
    {
      "ja": "(High！High！Foo！)",
      "romaji": "(High! High! Foo!)",
      "en": "(High! High! Foo!)",
      "zh": "（High！High！Foo！）"
    },
    {
      "ja": "大切な思い出",
      "romaji": "Taisetsu na Omoide",
      "en": "Precious memories",
      "zh": "重要的回憶"
    },
    {
      "ja": "沢山あるけどねまだ",
      "romaji": "Takusan Aru kedo ne Mada",
      "en": "There are so many, but still",
      "zh": "雖然有很多很多，但是"
    },
    {
      "ja": "感傷に浸ってる暇はない",
      "romaji": "Kanshou ni Hitatteru Hima ha Nai",
      "en": "There's no time to soak in sentimentality",
      "zh": "沒有時間沉浸在感傷裡"
    },
    {
      "ja": "今世紀最大の",
      "romaji": "Konseiki Saidai no",
      "en": "The greatest of this century",
      "zh": "本世紀最大的"
    },
    {
      "ja": "夏が始まる",
      "romaji": "Natsu ga Hajimaru",
      "en": "Summer begins",
      "zh": "夏天開始了"
    },
    {
      "ja": "Wow",
      "romaji": "Wow",
      "en": "Wow",
      "zh": "Wow"
    },
    {
      "ja": "想像の果てにある高み",
      "romaji": "Souzou no Hate ni Aru Takami",
      "en": "The heights at the end of imagination",
      "zh": "存在於想像盡頭的高峰"
    },
    {
      "ja": "Wow",
      "romaji": "Wow",
      "en": "Wow",
      "zh": "Wow"
    },
    {
      "ja": "勝ち取った景色は尊い",
      "romaji": "Kachitotta Keshiki ha Toutoi",
      "en": "The scenery we won is precious",
      "zh": "贏來的景色如此珍貴"
    },
