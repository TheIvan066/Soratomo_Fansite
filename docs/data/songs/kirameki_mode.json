  "lyrics": [
    {
      "ja": "※ただいま歌詞の翻訳はAIによる生成したものです。人工による翻訳は後ほどアップデートする予定です！",
      "romaji": "",
      "en": "※This translation is currently generated by AI. The refined version is coming soon!",
      "zh": "※此翻譯暫時是AI生成的。人工的翻譯會容後更新！"
    },
    {
      "ja": "Hey！ Hey！",
      "romaji": "Hey! Hey!",
      "en": "Hey! Hey!",
      "zh": "Hey！Hey！"
    },
    {
      "ja": "Turn it up tonight",
      "romaji": "Turn It Up Tonight",
      "en": "Turn it up tonight",
      "zh": "今晚把音量調大"
    },
    {
      "ja": "風まかせ飛び出して",
      "romaji": "Kaze Makase Tobidashite",
      "en": "Letting the wind guide us, we leap out",
      "zh": "隨風奔馳而出"
    },
    {
      "ja": "笑うだけで perfect day",
      "romaji": "Warau Dake de Perfect Day",
      "en": "Just laughing makes it a perfect day",
      "zh": "光是笑著就是 perfect day"
    },
    {
      "ja": "ノープランでもいいじゃん",
      "romaji": "Noo Puran demo Ii jan",
      "en": "No plan? That's fine, isn't it?",
      "zh": "沒有計畫也可以吧"
    },
    {
      "ja": "君がいれば OK！",
      "romaji": "Kimi ga Ireba OK!",
      "en": "As long as you're here, it's OK!",
      "zh": "只要有你就 OK！"
    },
    {
      "ja": "寄り道ばっかしてても",
      "romaji": "Yorimichi Bakka Shite te mo",
      "en": "Even if we do nothing but take detours",
      "zh": "即使盡是繞遠路"
    },
    {
      "ja": "全部思い出になるね",
      "romaji": "Zenbu Omoide ni Naru ne",
      "en": "It all becomes memories, doesn't it?",
      "zh": "全都會變成回憶呢"
    },
    {
      "ja": "「まだ帰りたくない！」って",
      "romaji": "「Mada Kaeritakunai!」 tte",
      "en": "Saying \"I don't want to go home yet!\"",
      "zh": "喊著「還不想回家！」"
    },
    {
      "ja": "同じタイミングで",
      "romaji": "Onaji Taimingu de",
      "en": "At the exact same timing",
      "zh": "在同一時刻"
    },
    {
      "ja": "Hands up！ 音に Ride on",
      "romaji": "Hands Up! Oto ni Ride On",
      "en": "Hands up! Ride on the sound",
      "zh": "Hands up！乘著音樂 Ride on"
    },
    {
      "ja": "高鳴ってく感情",
      "romaji": "Takanatteku Kanjou",
      "en": "These rising emotions",
      "zh": "逐漸高漲的情感"
    },
    {
      "ja": "映えとかもうどうでもいい",
      "romaji": "Bae to ka Mou Dou demo Ii",
      "en": "I don't care about looking good for photos anymore",
      "zh": "好不好拍已經無所謂了"
    },
    {
      "ja": "“楽しい”が最優勝",
      "romaji": "\"Tanoshii\" ga Sai Yuushou",
      "en": "\"Having fun\" is the grand prize",
      "zh": "「開心」就是最優勝"
    },
    {
      "ja": "Clap clap！ 声を頂戴",
      "romaji": "Clap Clap! Koe wo Choudai",
      "en": "Clap clap! Give me your voice",
      "zh": "Clap clap！給我你们的聲音"
    },
    {
      "ja": "はしゃいじゃえば問題ない",
      "romaji": "Hashaijae ba Mondai Nai",
      "en": "If we just go wild, there's no problem",
      "zh": "只要盡情玩鬧就沒問題"
    },
    {
      "ja": "一瞬だって逃したくない",
      "romaji": "Isshun Datte Nogashitakunai",
      "en": "I don't want to miss even a single moment",
      "zh": "連一瞬間都不想錯過"
    },
    {
      "ja": "このまま朝まで Alright！",
      "romaji": "Kono Mama Asa made Alright!",
      "en": "Just like this until morning—alright!",
      "zh": "就這樣到早上，Alright！"
    },
    {
      "ja": "もっと騒ごうよ",
      "romaji": "Motto Sawagou yo",
      "en": "Let's make more noise",
      "zh": "再更熱鬧一點吧"
    },
    {
      "ja": "まだ終われない！",
      "romaji": "Mada Owarenai!",
      "en": "We can't end yet!",
      "zh": "還不能結束！"
    },
    {
      "ja": "キラキラ止まんない！",
      "romaji": "Kira Kira Tomannai!",
      "en": "The sparkle won't stop!",
      "zh": "閃耀停不下來！"
    },
    {
      "ja": "君となら最高じゃん！",
      "romaji": "Kimi to Nara Saikou jan!",
      "en": "With you, it's the best!",
      "zh": "只要和你一起就最棒了！"
    },
    {
      "ja": "歌って　踊って",
      "romaji": "Utatte Odotte",
      "en": "Singing, dancing",
      "zh": "唱歌、跳舞"
    },
    {
      "ja": "今日をもっと好きになる",
      "romaji": "Kyou wo Motto Suki ni Naru",
      "en": "I come to love today even more",
      "zh": "更加喜歡今天了"
    },
    {
      "ja": "Shake it！ 鳴らして Now！",
      "romaji": "Shake It! Narashite Now!",
      "en": "Shake it! Ring it out now!",
      "zh": "Shake it！響起來 Now！"
    },
    {
      "ja": "この瞬間を連れてこう！",
      "romaji": "Kono Shunkan wo Tsuretekou!",
      "en": "Let's take this moment with us!",
      "zh": "把這一刻帶走吧！"
    },
    {
      "ja": "笑っていこうよ",
      "romaji": "Waratte Ikou yo",
      "en": "Let's keep on laughing",
      "zh": "繼續笑著走吧"
    },
    {
      "ja": "全部パーフェクト！",
      "romaji": "Zenbu Paafekuto!",
      "en": "Everything's perfect!",
      "zh": "全部都是完美！"
    },
    {
      "ja": "Jump up！ 声を頂戴",
      "romaji": "Jump Up! Koe wo Choudai",
      "en": "Jump up! Give me your voice",
      "zh": "Jump up！給我你们的聲音"
    },
    {
      "ja": "まだまだ遊び足りない",
      "romaji": "Mada Mada Asobi Tarinai",
      "en": "I still haven't played enough",
      "zh": "還遠遠玩不夠"
    },
    {
      "ja": "テンション上げて Everybody",
      "romaji": "Tenshon Agete Everybody",
      "en": "Raise the energy, everybody",
      "zh": "把氣氛炒熱，Everybody"
    },
    {
      "ja": "この景色を更新したい",
      "romaji": "Kono Keshiki wo Koushin Shitai",
      "en": "I want to update this scenery",
      "zh": "想更新這片景色"
    },
    {
      "ja": "Flash light　光る Wave",
      "romaji": "Flash Light Hikaru Wave",
      "en": "Flash light, shining wave",
      "zh": "Flash light，閃耀的 Wave"
    },
    {
      "ja": "繋がってく Feel so great",
      "romaji": "Tsunagatteku Feel So Great",
      "en": "We're connecting—feel so great",
      "zh": "彼此相繫，Feel so great"
    },
    {
      "ja": "目が合うたび笑っちゃう",
      "romaji": "Me ga Au Tabi Waratchau",
      "en": "Every time our eyes meet, I can't help laughing",
      "zh": "每次眼神交會就忍不住笑出來"
    },
    {
      "ja": "その感じが最高じゃない？",
      "romaji": "Sono Kanji ga Saikou ja Nai?",
      "en": "Isn't that feeling just the best?",
      "zh": "那種感覺不是最棒的嗎？"
    },
    {
      "ja": "イヤなこと忘れちゃって",
      "romaji": "Iya na Koto Wasurechatte",
      "en": "Forgetting all the unpleasant things",
      "zh": "把討厭的事都忘掉"
    },
    {
      "ja": "好きなように moving now",
      "romaji": "Suki na You ni Moving Now",
      "en": "Moving now just as we like",
      "zh": "隨心所欲地 moving now"
    },
    {
      "ja": "くだらない一言で",
      "romaji": "Kudaranai Hitokoto de",
      "en": "With a single silly word",
      "zh": "因為一句無聊的話"
    },
    {
      "ja": "また笑い止まらない",
      "romaji": "Mata Warai Tomaranai",
