  "lyrics": [
    {
      "ja": "※ただいま歌詞の翻訳はAIによる生成したものです。人工による翻訳は後ほどアップデートする予定です！",
      "romaji": "",
      "en": "※This translation is currently generated by AI. The refined version is coming soon!",
      "zh": "※此翻譯暫時是AI生成的。人工的翻譯會容後更新！"
    },
    {
      "ja": "はじめから僕らは",
      "romaji": "Hajime kara Bokura ha",
      "en": "From the very beginning, we",
      "zh": "從一開始我們就是"
    },
    {
      "ja": "繋がっていたんだ引力で",
      "romaji": "Tsunagatte Ita n Da Inryoku de",
      "en": "Were connected by gravity",
      "zh": "被引力連繫在一起"
    },
    {
      "ja": "出会えたのは必然",
      "romaji": "Deaeta no ha Hitsuzen",
      "en": "Our meeting was inevitable",
      "zh": "相遇是必然的"
    },
    {
      "ja": "君も気づいてるのかな",
      "romaji": "Kimi mo Kizuite Iru no Kana",
      "en": "I wonder if you've noticed too",
      "zh": "你是否也察覺到了呢"
    },
    {
      "ja": "遥か宇宙から見たぼくらは",
      "romaji": "Haruka Uchuu kara Mita Bokura ha",
      "en": "Seen from far out in space, we",
      "zh": "從遙遠宇宙看過來的我們"
    },
    {
      "ja": "まるでちっぽけな星屑",
      "romaji": "Marude Chippoke na Hoshikuzu",
      "en": "Are like tiny specks of stardust",
      "zh": "簡直就像微小的星屑"
    },
    {
      "ja": "君と出会えた瞬間に",
      "romaji": "Kimi to Deaeta Shunkan ni",
      "en": "The moment I met you",
      "zh": "在與你相遇的瞬間"
    },
    {
      "ja": "僕ら星座になれたの",
      "romaji": "Bokura Seiza ni Nareta no",
      "en": "We became a constellation",
      "zh": "我們成為了星座"
    },
    {
      "ja": "時間を超えて Don't stop　未来へ",
      "romaji": "Jikan wo Koete Don't Stop Mirai e",
      "en": "Transcending time—don't stop—toward the future",
      "zh": "超越時間，Don't stop，前往未來"
    },
    {
      "ja": "二つ重ねて超絶ミラクル",
      "romaji": "Futatsu Kasanete Chouzetsu Mirakuru",
      "en": "Two overlapping—a transcendental miracle",
      "zh": "兩者交疊，超絕奇蹟"
    },
    {
      "ja": "誰も止められない魔法",
      "romaji": "Dare mo Tomerarenai Mahou",
      "en": "A magic no one can stop",
      "zh": "誰也阻止不了的魔法"
    },
    {
      "ja": "レベチな僕らの銀河へ",
      "romaji": "Rebechi na Bokura no Ginga e",
      "en": "To our galaxy that's on another level",
      "zh": "前往規格不同的我們的銀河"
    },
    {
      "ja": "Party night",
      "romaji": "Party Night",
      "en": "Party night",
      "zh": "Party night"
    },
    {
      "ja": "wow oh",
      "romaji": "Wow Oh",
      "en": "Wow oh",
      "zh": "Wow oh"
    },
    {
      "ja": "ふたりは Destiny",
      "romaji": "Futari ha Destiny",
      "en": "The two of us are destiny",
      "zh": "兩人是 Destiny"
    },
    {
      "ja": "引力に引かれ光る Clarity",
      "romaji": "Inryoku ni Hikare Hikaru Clarity",
      "en": "Drawn by gravity, shining clarity",
      "zh": "被引力吸引而閃耀的 Clarity"
    },
    {
      "ja": "ドキドキして愛してねぇ、ワクワクして",
      "romaji": "Dokidoki Shite Aishite Nee, Wakuwaku Shite",
      "en": "Get excited and love me, hey—get thrilled",
      "zh": "心跳加速地愛我吧，興奮不已"
    },
    {
      "ja": "2人の GRAVITY",
      "romaji": "Futari no GRAVITY",
      "en": "Our gravity",
      "zh": "兩人的 GRAVITY"
    },
    {
      "ja": "感情のままに",
      "romaji": "Kanjou no Mama ni",
      "en": "Just as our feelings guide us",
      "zh": "隨著感情而行"
    },
    {
      "ja": "so dance music",
      "romaji": "So Dance Music",
      "en": "So dance music",
      "zh": "So dance music"
    },
    {
      "ja": "すれ違いもまた groovy",
      "romaji": "Surechigai mo Mata Groovy",
      "en": "Even our near-misses are groovy",
      "zh": "擦身而過也同樣 Groovy"
    },
    {
      "ja": "始めようぜ僕らの GRAVITY",
      "romaji": "Hajimeyou ze Bokura no GRAVITY",
      "en": "Let's begin our gravity",
      "zh": "開始吧，我們的 GRAVITY"
    },
    {
      "ja": "見つめてて朝が来るまで",
      "romaji": "Mitsumetete Asa ga Kuru made",
      "en": "Keep watching me until morning comes",
      "zh": "注視著我直到早晨來臨"
    },
    {
      "ja": "Yeah！！",
      "romaji": "Yeah!!",
      "en": "Yeah!!",
      "zh": "Yeah！！"
    },
    {
      "ja": "これが完全無欠な illusion",
      "romaji": "Kore ga Kanzen Muketsu na Illusion",
      "en": "This is a flawless illusion",
      "zh": "這是完美無缺的 illusion"
    },
    {
      "ja": "まさに完璧な Fusion",
      "romaji": "Masa ni Kanpeki na Fusion",
      "en": "Truly a perfect fusion",
      "zh": "正是完美的 Fusion"
    },
    {
      "ja": "歌い踊れば Solution",
      "romaji": "Utai Odoreba Solution",
      "en": "If we sing and dance, it's a solution",
      "zh": "又唱又跳就是 Solution"
    },
    {
      "ja": "ここは僕たちの Region",
      "romaji": "Koko ha Bokutachi no Region",
      "en": "This is our region",
      "zh": "這裡是我們的 Region"
    },
    {
      "ja": "みんなの力が重なり広がる",
      "romaji": "Minna no Chikara ga Kasanari Hirogaru",
      "en": "Everyone's power overlaps and expands",
      "zh": "大家的力量交疊並擴展"
    },
    {
      "ja": "たった1つの Universe",
      "romaji": "Tatta Hitotsu no Universe",
      "en": "Just one universe",
      "zh": "僅只一個的 Universe"
    },
    {
      "ja": "ねぇちょっと泣いたって",
      "romaji": "Nee Chotto Naita tte",
      "en": "Hey, even if you cry a little",
      "zh": "吶，就算稍微哭了一下"
    },
    {
      "ja": "明日は晴れる",
      "romaji": "Ashita ha Hareru",
      "en": "Tomorrow will be sunny",
      "zh": "明天也會放晴"
    },
    {
      "ja": "Take it easy",
      "romaji": "Take It Easy",
      "en": "Take it easy",
      "zh": "Take it easy"
    },
    {
      "ja": "1人でいないで Hold on",
      "romaji": "Hitori de Inai de Hold On",
      "en": "Don't be alone—hold on",
      "zh": "不要一個人，Hold on"
    },
    {
      "ja": "繋がるいつでも未来で",
      "romaji": "Tsunagaru Itsu demo Mirai de",
      "en": "We're connected, always, in the future",
      "zh": "隨時都在未來相繫"
    },
    {
      "ja": "Let's meet up",
