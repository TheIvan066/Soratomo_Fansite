/**
 * ULIZA Player
 */
(function () {
  'use strict';

  var PLAYER_OBJECT_NAME = 'ulizaPlayer';
  var CONTAINER_ID = 'jsi-bcplayer-video-container';
  var TAG_BASE =
    'https://player-api.p.uliza.jp/v1/players/default-player/jvcmusic2/admin' +
    '?type=normal&playerobjectname=' + PLAYER_OBJECT_NAME;

  // ======================================================================================
  // ULIZA Player Manager
  // ======================================================================================
  VICTOR.ULIZA_PLAYER_MANAGER = {
    init: function () {
      if (!this.setParams()) {
        return;
      }
      this.prepare();
    },
    setParams: function () {
      this.$players = $('.jsc-bcplayer');
      this.$timelinePlayers = $('.jsc-bcplayer-timeline');
      this.container = [];
      this.ulizaplayer = new VICTOR.ULIZA_PLAYER();
      return true;
    },
    prepare: function () {
      if (this.$players.length !== 0) {
        this.instantiate();
      }
      if (this.$timelinePlayers.length !== 0) {
        this.instantiateTimeline();
      }
    },
    instantiate: function () {
      for (var i = 0, len = this.$players.length; i < len; i++) {
        var bc = new VICTOR.ULIZA_PLAYER_CONTROLLER(this.$players.eq(i), this);
        if (bc.error === void (0)) {
          this.container.push(bc);
        }
      }
    },
    instantiateTimeline: function () {
      for (var i = 0, len = this.$timelinePlayers.length; i < len; i++) {
        var bc = new VICTOR.ULIZA_PLAYER_TIMELINE_CONTROLLER(this.$timelinePlayers.eq(i), this);
        if (bc.error === void (0)) {
          this.container.push(bc);
        }
      }
    },
    endedOtherPlayer: function () {
      for (var i = 0, len = this.container.length; i < len; i++) {
        this.container[i].ended();
      }
    },
    externalCreatePlayer: function ($player) {
      var bc = new VICTOR.ULIZA_PLAYER_CONTROLLER($player, this);
      if (bc.error === void (0)) {
        this.container.push(bc);
      }
    },
    externalCreateTimelinePlayer: function ($player) {
      var bc = new VICTOR.ULIZA_PLAYER_TIMELINE_CONTROLLER($player, this);
      if (bc.error === void (0)) {
        this.container.push(bc);
      }
    }
  };

  // ======================================================================================
  // ULIZA Player（単一インスタンス・公式タグ切替）
  // ======================================================================================
  VICTOR.ULIZA_PLAYER = function () {
    this.init();
  };

  VICTOR.ULIZA_PLAYER.prototype = {
    init: function () {
      this.setParams();
      if (!this._readyBound) {
        this._readyBound = true;
        var myself = this;
        window.addEventListener('ulizaplayerready', function () {
          myself.onPlayerReady();
        });
      }
    },
    setParams: function () {
      this.$videoContainer = $('#' + CONTAINER_ID);
      this.player = null;
      this.bcplayer = null;
      this.isPlay = false;
      this.isLoaded = false;
      this.isPlayerReady = false;
      this.isBusy = false;
      this.currentDataId = null;
      this.pendingSetPlayer = null;
      this._pendingResolve = null;
      this._pendingReject = null;
      this._pendingBtn = null;
    },

    isPlayerApiInstance: function (instance) {
      return instance &&
        typeof instance.on === 'function' &&
        typeof instance.play === 'function';
    },

    clearVideoContainer: function () {
      var container = document.getElementById(CONTAINER_ID);
      if (!container) {
        return;
      }
      while (container.firstChild) {
        container.removeChild(container.firstChild);
      }
    },

    failPlayerInit: function (message) {
      console.warn('[ULIZA] ' + message);
      window[PLAYER_OBJECT_NAME] = null;
      this.player = null;
      this.bcplayer = null;
      this.isPlayerReady = false;
      this.isLoaded = false;
      this.isBusy = false;
      this.clearVideoContainer();
      if (this._pendingBtn) {
        this._pendingBtn.removeClass('is-loading');
      }
      if (this._pendingReject) {
        this._pendingReject(new Error(message));
      }
      this._clearPending();
    },

    createVideojsAdapter: function (ulizaPlayer) {
      var handlers = {
        play: [],
        pause: [],
        ended: [],
        timeupdate: [],
        loadeddata: []
      };
      var firedLoadedData = false;

      function emit(event) {
        var list = handlers[event] || [];
        for (var i = 0; i < list.length; i++) {
          list[i]();
        }
      }

      function fireLoadedDataOnce() {
        if (firedLoadedData) {
          return;
        }
        firedLoadedData = true;
        emit('loadeddata');
      }

      ulizaPlayer.on('play', function () {
        emit('play');
        fireLoadedDataOnce();
      });
      ulizaPlayer.on('pause', function () {
        emit('pause');
      });
      ulizaPlayer.on('ended', function () {
        emit('ended');
      });
      ulizaPlayer.on('timeupdate', function () {
        emit('timeupdate');
      });

      var adapter = {
        _uliza: ulizaPlayer,
        play: function () {
          return ulizaPlayer.play();
        },
        pause: function () {
          return ulizaPlayer.pause();
        },
        currentTime: function (time) {
          if (time !== undefined) {
            if (typeof ulizaPlayer.currentTime === 'function') {
              ulizaPlayer.currentTime(time);
            } else if (typeof ulizaPlayer.setCurrentTime === 'function') {
              ulizaPlayer.setCurrentTime(time);
            }
            return;
          }
          if (typeof ulizaPlayer.currentTime === 'function') {
            return ulizaPlayer.currentTime();
          }
          if (typeof ulizaPlayer.getCurrentTime === 'function') {
            return ulizaPlayer.getCurrentTime();
          }
          return 0;
        },
        duration: function () {
          if (typeof ulizaPlayer.duration === 'function') {
            return ulizaPlayer.duration();
          }
          if (typeof ulizaPlayer.getDuration === 'function') {
            return ulizaPlayer.getDuration();
          }
          return 0;
        },
        volume: function (vol) {
          if (vol !== undefined) {
            if (typeof ulizaPlayer.volume === 'function') {
              ulizaPlayer.volume(vol);
            } else if (typeof ulizaPlayer.setVolume === 'function') {
              ulizaPlayer.setVolume(vol);
            }
            return;
          }
          if (typeof ulizaPlayer.volume === 'function') {
            return ulizaPlayer.volume();
          }
          if (typeof ulizaPlayer.getVolume === 'function') {
            return ulizaPlayer.getVolume();
          }
          return 0.5;
        },
        on: function (event, callback) {
          if (!handlers[event]) {
            handlers[event] = [];
          }
          handlers[event].push(callback);
          return adapter;
        }
      };

      fireLoadedDataOnce();
      return adapter;
    },

    disposeReadyPlayer: function () {
      if (!this.player) {
        window[PLAYER_OBJECT_NAME] = null;
        this.isPlayerReady = false;
        this.bcplayer = null;
        return;
      }
      try {
        if (typeof this.player.pause === 'function') {
          this.player.pause();
        }
        if (typeof this.player.off === 'function') {
          this.player.off();
        }
        if (typeof this.player.dispose === 'function') {
          this.player.dispose();
        }
      } catch (e) {
        console.warn('[ULIZA] dispose warning:', e.message);
      }
      this.player = null;
      this.bcplayer = null;
      window[PLAYER_OBJECT_NAME] = null;
      this.isPlayerReady = false;
    },

    removeBootstrapScripts: function () {
      var scripts = document.querySelectorAll('script[src*="player-api.p.uliza.jp"]');
      for (var i = 0; i < scripts.length; i++) {
        if (scripts[i].parentNode) {
          scripts[i].parentNode.removeChild(scripts[i]);
        }
      }
    },

    injectTag: function (dataId) {
      this.removeBootstrapScripts();
      var script = document.createElement('script');
      script.type = 'text/javascript';
      script.charset = 'utf-8';
      script.defer = true;
      script.src = TAG_BASE +
        '&name=' + encodeURIComponent(dataId) +
        '&targetid=' + CONTAINER_ID;
      script.setAttribute('data-uliza-content-id', dataId);
      document.head.appendChild(script);
    },

    safePlay: function () {
      if (!this.player || typeof this.player.play !== 'function') {
        return;
      }
      var result;
      try {
        result = this.player.play();
      } catch (e) {
        return;
      }
      if (result && typeof result.then === 'function') {
        result.then(null, function () { /* autoplay blocked */ });
      }
    },

    onPlayerReady: function () {
      // 自分（音声試聴）が起動したロードでなければ無視する。
      // 映像用 VICTOR.ULIZA_VIDEO_PLAYER も同一 'ulizaplayerready' を購読するため、混線を防ぐ。
      if (!this.isBusy) {
        return;
      }
      var instance = window[PLAYER_OBJECT_NAME];
      if (!instance) {
        this.failPlayerInit('ulizaPlayer not found (name=' + this.currentDataId + ')');
        return;
      }

      if (!this.isPlayerApiInstance(instance)) {
        this.failPlayerInit(
          'Invalid ulizaPlayer instance for name=' + this.currentDataId +
          ' (content missing or ULIZA error placeholder). ' +
          'Check VMS name / preview availability.'
        );
        return;
      }

      this.player = instance;
      this.isPlayerReady = true;
      this.isBusy = false;
      this.isLoaded = true;
      this.bcplayer = this.createVideojsAdapter(instance);

      if (typeof instance.volume === 'function') {
        instance.volume(0.5);
      } else if (typeof instance.setVolume === 'function') {
        instance.setVolume(0.5);
      }

      if (this._pendingBtn) {
        this._pendingBtn.removeClass('is-loading');
      }

      this.safePlay();

      if (this._pendingResolve) {
        this._pendingResolve();
      }
      this._clearPending();

      if (this.pendingSetPlayer) {
        var next = this.pendingSetPlayer;
        this.pendingSetPlayer = null;
        this.setPlayer(next.dataId, next.$btn).then(next.resolve, next.reject);
      }
    },

    _clearPending: function () {
      this._pendingResolve = null;
      this._pendingReject = null;
      this._pendingBtn = null;
    },

    setPlayer: function (dataId, $btn) {
      var myself = this;

      if (this.isBusy) {
        return new Promise(function (resolve, reject) {
          myself.pendingSetPlayer = {
            dataId: dataId,
            $btn: $btn,
            resolve: resolve,
            reject: reject
          };
        });
      }

      return new Promise(function (resolve, reject) {
        myself.isLoaded = false;
        myself.isBusy = true;
        myself.currentDataId = dataId;
        myself._pendingResolve = resolve;
        myself._pendingReject = reject;
        myself._pendingBtn = $btn;

        $btn.addClass('is-loading');

        if (myself.isPlayerReady && myself.player) {
          myself.disposeReadyPlayer();
        }

        requestAnimationFrame(function () {
          requestAnimationFrame(function () {
            myself.clearVideoContainer();
            myself.injectTag(dataId);
          });
        });
      });
    },

    play: function () {
      if (this.bcplayer) {
        this.bcplayer.play();
      }
    },

    pause: function () {
      if (this.bcplayer) {
        this.bcplayer.pause();
      }
    },

    getTimeRaito: function () {
      if (!this.bcplayer) {
        return 0;
      }
      var d = this.bcplayer.duration();
      if (!d) {
        return 0;
      }
      return this.bcplayer.currentTime() / d * 100;
    }
  };

  // ======================================================================================
  // ULIZA Video Player（モーダル内インライン映像再生）
  // 音声試聴と同じ「同一文書へのインライン注入」で iOS の sticky activation を活かし、
  // 音ありのまま 1 タップ再生を狙う。iframe 方式は境界でユーザー操作が委譲されず再生がブロックされる。
  // 音声側プレイヤーと混線しないよう、playerobjectname / targetid / bootstrap script を分離する。
  // ======================================================================================
  var VIDEO_OBJECT_NAME = 'ulizaVideoPlayer';
  var VIDEO_CONTAINER_ID = 'jsi-uliza-video-target';
  var VIDEO_TAG_BASE =
    'https://player-api.p.uliza.jp/v1/players/default-player/jvcmusic2/admin' +
    '?type=normal&playerobjectname=' + VIDEO_OBJECT_NAME;

  VICTOR.ULIZA_VIDEO_PLAYER = {
    player: null,
    isBusy: false,
    isReady: false,
    currentName: null,
    _readyBound: false,
    _playsinlineTimer: null,

    init: function () {
      if (this._readyBound) {
        return;
      }
      this._readyBound = true;
      var myself = this;
      window.addEventListener('ulizaplayerready', function () {
        myself.onPlayerReady();
      });
    },

    isPlayerApiInstance: function (instance) {
      return instance &&
        typeof instance.on === 'function' &&
        typeof instance.play === 'function';
    },

    open: function (name) {
      this.init();
      var container = document.getElementById(VIDEO_CONTAINER_ID);
      if (!container) {
        return;
      }
      // 既存プレイヤーを破棄してから新規ロード
      this.dispose();
      this.isBusy = true;
      this.isReady = false;
      this.currentName = name;
      this.injectTag(name);
    },

    injectTag: function (name) {
      // 自分の旧 bootstrap script のみ除去（音声側 script は残す）
      var olds = document.querySelectorAll('script[data-uliza-video="1"]');
      for (var i = 0; i < olds.length; i++) {
        if (olds[i].parentNode) {
          olds[i].parentNode.removeChild(olds[i]);
        }
      }
      var script = document.createElement('script');
      script.type = 'text/javascript';
      script.charset = 'utf-8';
      script.defer = true;
      script.setAttribute('data-uliza-video', '1');
      script.src = VIDEO_TAG_BASE +
        '&name=' + encodeURIComponent(name) +
        '&targetid=' + VIDEO_CONTAINER_ID;
      document.head.appendChild(script);
    },

    onPlayerReady: function () {
      // 自分（映像）が起動したロードでなければ無視
      if (!this.isBusy) {
        return;
      }
      var instance = window[VIDEO_OBJECT_NAME];
      if (!this.isPlayerApiInstance(instance)) {
        return;
      }
      this.player = instance;
      this.isReady = true;
      this.isBusy = false;
      this.enablePlaysinline();
      this.safePlay();
    },

    enablePlaysinline: function () {
      var tries = 0;
      if (this._playsinlineTimer) {
        clearInterval(this._playsinlineTimer);
      }
      this._playsinlineTimer = setInterval(function () {
        tries++;
        var vids = document.querySelectorAll('#' + VIDEO_CONTAINER_ID + ' video');
        for (var i = 0; i < vids.length; i++) {
          vids[i].setAttribute('playsinline', '');
          vids[i].setAttribute('webkit-playsinline', '');
          vids[i].style.width = '100%';
          vids[i].style.height = '100%';
        }
        if (vids.length > 0 || tries > 40) {
          clearInterval(VICTOR.ULIZA_VIDEO_PLAYER._playsinlineTimer);
          VICTOR.ULIZA_VIDEO_PLAYER._playsinlineTimer = null;
        }
      }, 100);
    },

    safePlay: function () {
      if (!this.player || typeof this.player.play !== 'function') {
        return;
      }
      var result;
      try {
        result = this.player.play();
      } catch (e) {
        return;
      }
      if (result && typeof result.then === 'function') {
        result.then(null, function () { /* autoplay blocked */ });
      }
    },

    dispose: function () {
      if (this._playsinlineTimer) {
        clearInterval(this._playsinlineTimer);
        this._playsinlineTimer = null;
      }
      if (this.player) {
        try {
          if (typeof this.player.pause === 'function') {
            this.player.pause();
          }
          if (typeof this.player.off === 'function') {
            this.player.off();
          }
          if (typeof this.player.dispose === 'function') {
            this.player.dispose();
          }
        } catch (e) {
          /* noop */
        }
      }
      this.player = null;
      this.isReady = false;
      this.isBusy = false;
      window[VIDEO_OBJECT_NAME] = null;
      var container = document.getElementById(VIDEO_CONTAINER_ID);
      if (container) {
        while (container.firstChild) {
          container.removeChild(container.firstChild);
        }
      }
    }
  };

  // ======================================================================================
  // ULIZA Player Controller（試聴ボタン）
  // ======================================================================================
  VICTOR.ULIZA_PLAYER_CONTROLLER = function ($controller, manager) {
    this.$controller = $controller;
    this.manager = manager;
    return this.init() ? this : { error: true };
  };

  VICTOR.ULIZA_PLAYER_CONTROLLER.prototype = {
    init: function () {
      if (!this.setParams()) {
        return false;
      }
      this.prepare();
      this.bindEvents();
      return true;
    },
    setParams: function () {
      this.$playBtn = this.$controller.find('.jsc-bcplayer-button');
      if (this.$playBtn.length === 0) {
        return false;
      }
      this.$playSeek = this.$controller.find('.jsc-bcplayer-seek');
      this.dataId = this.$controller.attr('data-id');
      this.isPlay = false;
      this.initPlay = true;
      return true;
    },
    prepare: function () {
      var strokeDasharray = this.$playSeek.css('stroke-dasharray');
      if (strokeDasharray && strokeDasharray.indexOf(',') > -1) {
        var parts = strokeDasharray.split(',');
        this.initStrokeDasharray = parts[1] ? parts[1].replace('px', '') - 0 : 88;
      } else {
        this.initStrokeDasharray = 88;
      }
      this.$playSeek.css({ strokeDasharray: '0, ' + this.initStrokeDasharray + 'px' });
    },
    bindEvents: function () {
      this.$playBtn.on('click', $.proxy(this.togglePlay, this));
    },
    togglePlay: function () {
      var myself = this;
      if (this.$playBtn.hasClass('is-loading')) {
        return;
      }
      if (this.initPlay) {
        this.manager.endedOtherPlayer();
        this.manager.ulizaplayer.setPlayer(this.dataId, this.$playBtn)
          .then(function () {
            var bp = myself.manager.ulizaplayer.bcplayer;
            bp.on('ended', $.proxy(myself.ended, myself));
            bp.on('play', function () {
              myself.isPlay = true;
              myself.$playBtn.addClass('is-play');
            });
            bp.on('pause', function () {
              myself.isPlay = false;
              myself.$playBtn.removeClass('is-play');
            });
            myself.initPlay = false;
            myself.startSeek();
          })
          .catch(function () {
            myself.$playBtn.removeClass('is-loading');
          });
      } else if (this.isPlay) {
        if (!this.manager.ulizaplayer.isLoaded) {
          return;
        }
        this.manager.ulizaplayer.bcplayer.pause();
        this.pauseSeek();
        this.isPlay = false;
      } else {
        if (!this.manager.ulizaplayer.isLoaded) {
          return;
        }
        this.$playBtn.addClass('is-play');
        this.manager.ulizaplayer.bcplayer.play();
        this.startSeek();
        this.isPlay = true;
      }
    },
    ended: function () {
      if (this.initPlay) {
        return;
      }
      if (this.isPlay && this.manager.ulizaplayer.bcplayer) {
        this.manager.ulizaplayer.bcplayer.pause();
      }
      this.stopSeek();
      this.isPlay = false;
      this.initPlay = true;
    },
    startSeek: function () {
      var myself = this;
      this.manager.ulizaplayer.bcplayer.on('timeupdate', function () {
        var bp = myself.manager.ulizaplayer.bcplayer;
        var dur = bp.duration();
        if (!dur) {
          return;
        }
        var strokeDasharray = bp.currentTime() / dur * myself.initStrokeDasharray;
        myself.$playSeek.css({
          strokeDasharray: strokeDasharray + 'px, ' + myself.initStrokeDasharray + 'px'
        });
      });
      this.$playBtn.addClass('is-active');
    },
    pauseSeek: function () {
      this.$playBtn.removeClass('is-play');
    },
    stopSeek: function () {
      this.$playBtn.removeClass('is-active');
      this.$playBtn.removeClass('is-play');
      this.$playBtn.removeClass('is-loading');
      this.$playSeek.css({ strokeDasharray: '0, ' + this.initStrokeDasharray + 'px' });
    }
  };

  // ======================================================================================
  // ULIZA Player Timeline Controller（モーダル試聴）
  // ======================================================================================
  VICTOR.ULIZA_PLAYER_TIMELINE_CONTROLLER = function ($controller, manager) {
    this.$controller = $controller;
    this.manager = manager;
    return this.init() ? this : { error: true };
  };

  VICTOR.ULIZA_PLAYER_TIMELINE_CONTROLLER.prototype = {
    init: function () {
      if (!this.setParams()) {
        return false;
      }
      this.prepare();
      this.bindEvents();
      if (window === window.parent) {
        if (this.initLoad && this.onlyPC ? !VICTOR.UA.isSP() && !VICTOR.UA.isIOS() : true) {
          this.$playBtn.trigger('click');
        }
      } else {
        if (this.initLoad) {
          this.$playBtn.trigger('click');
        }
      }
      return true;
    },
    setParams: function () {
      this.$playBtn = this.$controller.find('.jsc-bcplayer-button');
      if (this.$playBtn.length === 0) {
        return false;
      }
      this.$playSeek = this.$controller.find('.jsc-bcplayer-seek');
      this.$playSeekCurrent = this.$playSeek.find('.jsc-bcplayer-seek-current');
      this.$playSeekControl = this.$playSeek.find('.jsc-bcplayer-seek-control');
      this.$playTime = this.$controller.find('.jsc-bcplayer-time');
      this.$reverseTime = this.$controller.find('.jsc-bcplayer-reverse-time');
      this.$playDuration = this.$controller.find('.jsc-bcplayer-time-duration');
      this.$volumeOff = this.$controller.find('.jsc-bcplayer-volume-off');
      this.$volumeMax = this.$controller.find('.jsc-bcplayer-volume-max');
      this.$volumeSeek = this.$controller.find('.jsc-bcplayer-volume-seek');
      this.$volumeCurrent = this.$controller.find('.jsc-bcplayer-volume-current');
      this.$body = $('body');
      this.dataId = this.$controller.attr('data-id');
      this.initLoad = this.$controller.attr('data-preload') === 'true' || false;
      this.onlyPC = this.$controller.attr('data-only-pc') === 'true' || false;
      this.$endTrigger = this.$controller.attr('data-end-player-trigger')
        ? $('.' + this.$controller.attr('data-end-player-trigger'))
        : null;
      this.isPlay = false;
      this.initPlay = true;
      this.isLoading = false;
      this.intervalTimer = null;
      this.isControllerDraggable = false;
      return true;
    },
    prepare: function () {
      this.$playSeekCurrent.css({ width: '0' });
      this.$playTime.text('00:00');
      this.$playDuration.text('00:00');
    },
    bindEvents: function () {
      var myself = this;
      this.$playBtn.on('click', $.proxy(this.togglePlay, this));
      this.$playSeek.on('click', $.proxy(this.clickChangeTime, this));
      this.$reverseTime.on('click', function () {
        myself.setTime(0);
        myself.timeUpdate();
      });
      this.$playSeekControl.on('mousedown', $.proxy(this.startControlTime, this));
      this.$volumeOff.on('click', $.proxy(this.setVolume, this, 0));
      this.$volumeMax.on('click', $.proxy(this.setVolume, this, 1));
      this.$volumeSeek.on('click', $.proxy(this.clickChangeVolume, this));
      this.$volumeCurrent.on('mousedown', $.proxy(this.startControlVolume, this));
      if (this.$endTrigger != null) {
        this.$endTrigger.on('click', $.proxy(this.ended, this));
      }
    },
    togglePlay: function () {
      var myself = this;
      if (!this.initLoad) {
        return;
      }
      var up = this.manager.ulizaplayer;

      if (up.isPlayerReady && up.bcplayer && up.currentDataId === this.dataId) {
        this.initPlay = false;
        if (this.isPlay) {
          up.bcplayer.pause();
          this.pauseSeek();
        } else {
          up.bcplayer.play();
          this.startSeek();
        }
        return;
      }

      // ロード中の多重クリックは無視
      if (this.isLoading) {
        return;
      }
      this.isLoading = true;
      this.manager.endedOtherPlayer();
      up.setPlayer(this.dataId, this.$playBtn)
        .then(function () {
          myself.bindPlayerEvents();
          myself.initPlay = false;
          myself.isLoading = false;
          myself.startSeek();
        })
        .catch(function () {
          myself.isLoading = false;
          myself.$playBtn.removeClass('is-loading');
        });
    },
    bindPlayerEvents: function () {
      var myself = this;
      var bp = this.manager.ulizaplayer.bcplayer;
      if (!bp) {
        return;
      }
      bp.on('ended', $.proxy(this.ended, this));
      bp.on('play', function () {
        myself.isPlay = true;
        myself.$playBtn.addClass('is-play');
      });
      bp.on('pause', function () {
        myself.isPlay = false;
        myself.$playBtn.removeClass('is-play');
      });
    },
    ended: function () {
      var myself = this;
      if (this.initPlay) {
        return;
      }
      if (this.isPlay && this.manager.ulizaplayer.bcplayer) {
        this.manager.ulizaplayer.bcplayer.pause();
      }
      if (this.manager.ulizaplayer.bcplayer) {
        this.manager.ulizaplayer.bcplayer.on('loadeddata', function () {
          myself.manager.ulizaplayer.bcplayer.pause();
        });
      }
      this.stopSeek();
      this.$playTime.text('00:00');
      this.isPlay = false;
    },
    startSeek: function () {
      clearInterval(this.intervalTimer);
      this.intervalTimer = setInterval($.proxy(this.timeUpdate, this), 1000 / 60);
      this.$playBtn.addClass('is-active');
    },
    pauseSeek: function () {
      clearInterval(this.intervalTimer);
      this.$playBtn.removeClass('is-play');
    },
    stopSeek: function () {
      clearInterval(this.intervalTimer);
      this.$playBtn.removeClass('is-active');
      this.$playBtn.removeClass('is-play');
      this.$playBtn.removeClass('is-loading');
      this.$playSeekControl.css({ left: '-8px' });
      this.$playSeekCurrent.css({ width: '0' });
    },
    calcTime: function (time) {
      var minutes = Math.floor(Math.round(time) / 60);
      var seconds = time === 0 ? Math.round(time) % 60 - 1 : Math.round(time) % 60;
      if (seconds < 0) {
        seconds = 0;
      }
      minutes = (minutes + '').length > 1 ? minutes : '0' + minutes;
      seconds = (seconds + '').length > 1 ? seconds : '0' + seconds;
      return minutes + ':' + seconds;
    },
    setTime: function (persent) {
      var bp = this.manager.ulizaplayer.bcplayer;
      if (!bp) {
        return;
      }
      var duration = bp.duration();
      bp.currentTime(duration * persent);
    },
    timeUpdate: function () {
      var bp = this.manager.ulizaplayer.bcplayer;
      if (!bp) {
        return;
      }
      var duration = bp.duration();
      var currentTime = bp.currentTime();
      var controlWidth = this.$playSeekControl.width();
      var seekWidth = currentTime / duration * 100;
      this.$playSeekCurrent.css({ width: seekWidth + '%' });
      this.$playSeekControl.css({ left: seekWidth / 100 * this.$playSeek.width() - controlWidth / 2 });
      if (duration !== 0) {
        this.$playTime.text(this.calcTime(currentTime));
      }
      if (duration !== 0 && !isNaN(duration) && this.$playDuration.text() === '00:00') {
        this.$playDuration.text(this.calcTime(duration));
      }
    },
    clickChangeTime: function (e) {
      e.preventDefault();
      e.stopPropagation();
      if (this.isControllerDraggable) {
        return;
      }
      this.setTime(e.originalEvent.offsetX / this.$playSeek.width());
      this.timeUpdate();
    },
    setVolume: function (persent) {
      if (VICTOR.UA.isIOS()) {
        return;
      }
      this.$volumeCurrent.css({ left: this.$volumeSeek.width() * persent });
      var bp = this.manager.ulizaplayer.bcplayer;
      if (bp) {
        bp.volume(persent);
      }
    },
    clickChangeVolume: function (e) {
      e.preventDefault();
      e.stopPropagation();
      if (VICTOR.UA.isIOS()) {
        return;
      }
      if (this.isControllerDraggable) {
        return;
      }
      this.setVolume(e.originalEvent.offsetX / this.$volumeSeek.width());
    },
    startControlTime: function (e) {
      e.preventDefault();
      e.stopPropagation();
      this.isControllerDraggable = true;
      this.$body.on('mouseup.controltime', $.proxy(this.endControlTime, this));
      this.$body.on('mousemove.controltime', $.proxy(this.moveControlTime, this));
      clearInterval(this.intervalTimer);
      this.startControlTimePosX = e.originalEvent.pageX;
      this.startControlTimeLeft = parseFloat(this.$playSeekControl.css('left').replace('px', ''));
    },
    moveControlTime: function (e) {
      e.preventDefault();
      e.stopPropagation();
      var diff = e.originalEvent.pageX - this.startControlTimePosX;
      var seekWidth = this.$playSeek.width();
      var controlWidth = this.$playSeekControl.width();

      if (this.startControlTimeLeft + diff < -controlWidth / 2) {
        this.$playSeekControl.css({ left: -controlWidth / 2 });
        this.$playSeekCurrent.css({ width: 0 });
      } else if (this.startControlTimeLeft + diff > seekWidth - controlWidth / 2) {
        this.$playSeekControl.css({ left: seekWidth - controlWidth / 2 });
        this.$playSeekCurrent.css({ width: seekWidth });
      } else {
        this.$playSeekControl.css({ left: this.startControlTimeLeft + diff });
        this.$playSeekCurrent.css({ width: this.startControlTimeLeft + diff });
      }
    },
    endControlTime: function (e) {
      e.preventDefault();
      e.stopPropagation();
      var diff = e.originalEvent.pageX - this.startControlTimePosX;
      this.$body.off('mouseup.controltime');
      this.$body.off('mousemove.controltime');
      clearInterval(this.intervalTimer);

      var seekWidth = this.$playSeek.width();
      var controlWidth = this.$playSeekControl.width();

      if (this.startControlTimeLeft + diff < -controlWidth / 2) {
        this.$playSeekControl.css({ left: -controlWidth / 2 });
        this.$playSeekCurrent.css({ width: 0 });
        this.setTime(0);
      } else if (this.startControlTimeLeft + diff > seekWidth - controlWidth / 2) {
        this.$playSeekControl.css({ left: seekWidth - controlWidth / 2 });
        this.$playSeekCurrent.css({ width: seekWidth });
        this.setTime(seekWidth / seekWidth);
      } else {
        this.$playSeekControl.css({ left: this.startControlTimeLeft + diff });
        this.$playSeekCurrent.css({ width: this.startControlTimeLeft + diff });
        this.setTime((this.startControlTimeLeft + diff) / seekWidth);
      }

      var myself = this;
      setTimeout(function () {
        myself.isControllerDraggable = false;
      }, 0);

      this.intervalTimer = setInterval($.proxy(this.timeUpdate, this), 1000 / 60);
    },
    startControlVolume: function (e) {
      e.preventDefault();
      e.stopPropagation();
      this.isControllerDraggable = true;
      this.$body.on('mouseup.controlvolume', $.proxy(this.endControlVolume, this));
      this.$body.on('mousemove.controlvolume', $.proxy(this.moveControlVolume, this));
      this.startControlVolumePosX = e.originalEvent.pageX;
      this.startControlVolumeLeft = this.$volumeCurrent.css('left').replace('px', '') - 0;
    },
    moveControlVolume: function (e) {
      e.preventDefault();
      e.stopPropagation();
      var diff = e.originalEvent.pageX - this.startControlVolumePosX;
      var seekWidth = this.$volumeSeek.width();
      var controlWidth = this.$volumeCurrent.width();

      if (this.startControlVolumeLeft + diff < controlWidth / 2) {
        this.$volumeCurrent.css({ left: -controlWidth / 2 });
        this.setVolume(0);
      } else if (this.startControlVolumeLeft + diff > seekWidth - controlWidth / 2) {
        this.$volumeCurrent.css({ left: seekWidth - controlWidth / 2 });
        this.setVolume(1);
      } else {
        this.$volumeCurrent.css({ left: this.startControlVolumeLeft + diff });
        this.setVolume((this.startControlVolumeLeft + diff) / seekWidth);
      }
    },
    endControlVolume: function (e) {
      e.preventDefault();
      e.stopPropagation();
      this.$body.off('mouseup.controlvolume');
      this.$body.off('mousemove.controlvolume');
      var diff = e.originalEvent.pageX - this.startControlVolumePosX;

      var seekWidth = this.$volumeSeek.width();
      var controlWidth = this.$volumeCurrent.width();

      if (this.startControlVolumeLeft + diff < -controlWidth / 2) {
        this.$volumeCurrent.css({ left: -controlWidth / 2 });
        this.setVolume(0);
      } else if (this.startControlVolumeLeft + diff > seekWidth - controlWidth / 2) {
        this.$volumeCurrent.css({ left: seekWidth - controlWidth / 2 });
        this.setVolume(1);
      } else {
        this.$volumeCurrent.css({ left: this.startControlVolumeLeft + diff });
        this.setVolume((this.startControlVolumeLeft + diff) / seekWidth);
      }

      var myself = this;
      setTimeout(function () {
        myself.isControllerDraggable = false;
      }, 0);
    }
  };

  // プレイヤーマネージャ取得は main.js の VICTOR.getPlayerManager を使用

  // ======================================================================================
  // 初期化（uliza エンジンページのみ）
  // ======================================================================================
  $(function () {
    if (VICTOR.PLAYER_ENGINE === 'uliza') {
      VICTOR.ULIZA_PLAYER_MANAGER.init();
    }
  });

  window.addEventListener('beforeunload', function () {
    if (VICTOR.PLAYER_ENGINE === 'uliza' && VICTOR.ULIZA_PLAYER_MANAGER && VICTOR.ULIZA_PLAYER_MANAGER.ulizaplayer) {
      VICTOR.ULIZA_PLAYER_MANAGER.ulizaplayer.disposeReadyPlayer();
    }
  });
})();
